tton type="button" class="live-demo-ctx-palette-chip" data-cmd="delight"><span class="live-demo-ctx-palette-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:block"><path d="M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2z"/></svg></span><span class="live-demo-ctx-palette-name">Delight</span></button><button type="button" class="live-demo-ctx-palette-chip" data-cmd="overdrive"><span class="live-demo-ctx-palette-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:block"><path d="M13 3L5 13h5l-1 8 9-12h-6z"/></svg></span><span class="live-demo-ctx-palette-name">Overdrive</span></button></div></div><div class="live-demo-ctx-row live-demo-ctx-row--generating"><span class="live-demo-ctx-spinner" aria-hidden="true"></span><span>Generating variants…</span></div><div class="live-demo-ctx-row live-demo-ctx-row--cycling"><button type="button" class="live-demo-ctx-nav" aria-label="Previous variant">‹</button><span class="live-demo-ctx-counter" data-demo-counter>1 / 3</span><button type="button" class="live-demo-ctx-nav" aria-label="Next variant">›</button><span class="live-demo-ctx-divider"></span><button type="button" class="live-demo-ctx-discard" aria-label="Discard">✕</button><button type="button" class="live-demo-ctx-accept" data-demo-accept>Accept</button></div><div class="live-demo-ctx-row live-demo-ctx-row--accepted"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Variant 3 written to source</span></div></div><div class="live-demo-cursor" data-demo-cursor aria-hidden="true"><svg width="18" height="22" viewBox="0 0 18 22" fill="none"><path d="M1 1 L1 17 L5 13 L8 20 L11 19 L7.5 12 L13 12 Z" fill="var(-