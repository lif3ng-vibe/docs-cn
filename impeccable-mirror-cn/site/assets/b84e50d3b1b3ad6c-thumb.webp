ono:wght@400;500&display=swap" rel="stylesheet"><script>// Exceptions we cannot act on, dropped in posthog.astro's before_send. This
// file is inlined into the page as a classic script (no imports, no exports
// beyond the one function), so keep it self-contained.
//
// Keep unknown rejections, SDK failures and first-party stacks observable.
// Drop only opaque cross-origin errors, foreign-only stacks, the SDK's own
// request timeout, and identifiable extension or injected wallet failures.
function isUnactionableException(properties) {
  var list = (properties && properties.$exception_list) || [];
  if (!list.length) return false;
  var framesOf = function (e) { return (e.stacktrace && e.stacktrace.frames) || []; };
  var page = function (url) { return String(url || '').split(/[?#]/)[0]; };
  var currentPage = page(properties.$current_url);
  var isPage = function (f) { return /^https?:/.test(f.filename || '') && currentPage && page(f.filename) === currentPage; };
  var foreign = list.every(function (e) {
    var own = framesOf(e);
    return own.length > 0 && own.every(function (f) { return !/^https?:/.test(f.filename || ''); });
  });
  var opaque = list.every(function (e) { return e.value === 'Script error.' && framesOf(e).length === 0; });
  var sdkTimeout = list.every(function (e) {
    var own = framesOf(e);
    return /^PostHog request timed out after \d+ms$/.test(e.value || '') && own.length > 0 &&
      own.every(function (f) { return /^https?:\/\/[^/]+\/relay\/static\//.test(f.filename || ''); });
  });
  // PostHog orders frames outermost first. Only discard an extension throw
  // when the rest of the stack contains page URLs or foreign frames; a
  // first-party bundle anywhere in the chain keeps the exception actionable.
  var inExtension = list.every(function (e) {
    var own = framesOf(e);
    return own.length > 0 && /^(webkit-masked-url|chrome-extension|moz-extension|safari-web-extension):/.test(own[own.length - 1].filename || '') &&
      own.every(function (f) { return !/^https?:/.test(f.filename || '') || isPage(f); });
  });
  // This exact Brave iOS wallet injection runs against the page itself.
  // Other ethereum messages and exceptions from site bundles remain visible.
  var wallet = list.every(function (e) {
    var own = framesOf(e);
    return e.value === "undefined is not an object (evaluating 'window.ethereum.selectedAddress = undefined')" &&
      own.length > 0 && own.every(isPage);
  });
  return foreign || opaque || sdkTimeout || inExtension || wallet;
}
