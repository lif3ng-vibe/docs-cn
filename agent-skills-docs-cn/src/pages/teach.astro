---
import Base from '../layouts/Base.astro';
import CopyCommand from '../components/CopyCommand.astro';
import { diagrams, decks, usageModes, stickers, REPO } from '../data/teach';
import { INSTALL_CMD } from '../data/skills';

const tagline = '面向 AI 编码智能体的生产级工程技能。把资深工程师的工作流编码到完整的软件生命周期中。';
const shareLine = 'agent-skills：让 AI 编码智能体遵循真实软件开发生命周期（SDLC）的生产级技能。一条命令装进 70+ 智能体。https://skills.addy.ie';
---

<Base
  title="教学与分享 - agent-skills 媒体包"
  description="即取即用的品牌风格资源：SVG 与 PNG 工作流图示、101/201/301 幻灯片（HTML 与 PPTX），以及面向 agent-skills SDLC 的个人、团队与自定义指南。"
>
  <!-- HERO -->
  <section class="t-hero">
    <div class="grid-bg"></div>
    <div class="t-hero-glow" aria-hidden="true"></div>
    <div class="container t-hero-inner">
      <span class="eyebrow">教学与分享</span>
      <h1 class="t-h1">一套把 SDLC 故事讲全的媒体包</h1>
      <p class="t-lede">
        讲解、授课、发帖所需的一切都在这里：品牌风格的工作流图示、随时可讲的幻灯片（deck），以及个人工作、团队协作与自定义的通俗指南。随手取用，自由复用。MIT 许可，无需注册。
      </p>
      <div class="t-hero-cta">
        <a href="#diagrams" class="btn btn-primary">获取图示</a>
        <a href="#decks" class="btn btn-secondary">浏览幻灯片</a>
      </div>
    </div>
  </section>

  <!-- DECKS / TRACKS -->
  <section class="section" id="decks">
    <div class="container">
      <div class="t-head reveal">
        <span class="eyebrow"><span class="t-num">01</span> 学习路径</span>
        <h2 class="section-title">101、201、301——几分钟内开讲或分享</h2>
        <p class="section-lede">
          三套自成体系的幻灯片（deck），从第一性原理一路讲到团队落地。HTML 版直接在浏览器里演示（方向键翻页，F 全屏，P 导出 PDF），也可以下载 PPTX 自行编辑，改造成你自己的版本。
        </p>
      </div>

      <div class="deck-grid reveal">
        {decks.map((d) => (
          <article class="card deck-card" style={`--h:${d.hue}`}>
            <div class="deck-top">
              <span class="deck-level mono">{d.level}</span>
              <span class="deck-slides mono">{d.slides} 页</span>
            </div>
            <h3 class="deck-title">{d.title}</h3>
            <p class="deck-blurb">{d.blurb}</p>
            <ul class="deck-covers">
              {d.covers.map((c) => <li>{c}</li>)}
            </ul>
            <div class="deck-actions">
              <a href={`/docs-cn/agent-skills/teach/decks/${d.slug}.html`} target="_blank" rel="noopener" class="btn btn-primary deck-btn">
                演示
                <svg viewBox="0 0 16 16" fill="none"><path d="M4 8h8M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <a href={`/docs-cn/agent-skills/teach/decks/${d.slug}.pptx`} download class="btn btn-secondary deck-btn">
                <svg viewBox="0 0 16 16" fill="none"><path d="M8 2v8m0 0 3-3m-3 3L5 7M3 13h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                PPTX
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- DIAGRAMS -->
  <section class="section" id="diagrams">
    <div class="container">
      <div class="t-head reveal">
        <span class="eyebrow"><span class="t-num">02</span> 工作流图示</span>
        <h2 class="section-title">拿来即用的视觉素材，风格与品牌统一</h2>
        <p class="section-lede">
          五张图示，一眼讲清这套模型。下载 SVG 可在任意尺寸下保持清晰，下载 PNG 则方便直接贴进帖子、幻灯片或推文串。
        </p>
      </div>

      <div class="diagram-grid reveal">
        {diagrams.map((d) => (
          <figure class="card diagram-card" style={`--h:${d.hue}`}>
            <a href={`/docs-cn/agent-skills/teach/diagrams/${d.slug}.svg`} target="_blank" rel="noopener" class="diagram-frame">
              <img src={`/docs-cn/agent-skills/teach/diagrams/${d.slug}.svg`} alt={d.title} loading="lazy" width="1280" height="720" />
            </a>
            <figcaption class="diagram-meta">
              <div class="diagram-text">
                <h3 class="diagram-title">{d.title}</h3>
                <p class="diagram-blurb">{d.blurb}</p>
              </div>
              <div class="diagram-dl">
                <a href={`/docs-cn/agent-skills/teach/diagrams/${d.slug}.svg`} download class="dl-btn">SVG</a>
                <a href={`/docs-cn/agent-skills/teach/diagrams/${d.slug}.png`} download class="dl-btn">PNG</a>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- HOW YOU USE IT -->
  <section class="section">
    <div class="container">
      <div class="t-head reveal">
        <span class="eyebrow"><span class="t-num">03</span> 使用方式</span>
        <h2 class="section-title">同一套生命周期，单干或组队都适用</h2>
        <p class="section-lede">
          软件开发生命周期（SDLC）是整个项目的脊柱。这里展示它在你独自工作、团队协作时分别如何展开，以及如何针对你自己的技术栈做自定义。
        </p>
      </div>

      <div class="modes reveal">
        {usageModes.map((m, i) => (
          <article class="mode-row" style={`--h:${m.hue ?? 205}`} data-flip={i % 2 === 1}>
            <a href={`/docs-cn/agent-skills/teach/diagrams/${m.diagram}.svg`} target="_blank" rel="noopener" class="mode-figure">
              <img src={`/docs-cn/agent-skills/teach/diagrams/${m.diagram}.svg`} alt={m.headline} loading="lazy" width="1280" height="720" />
            </a>
            <div class="mode-copy">
              <span class="mode-label mono">{m.label}</span>
              <h3 class="mode-headline">{m.headline}</h3>
              <p class="mode-body">{m.body}</p>
              <ul class="mode-points">
                {m.points.map((p) => <li>{p}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- SHARE KIT -->
  <section class="section">
    <div class="container">
      <div class="t-head reveal">
        <span class="eyebrow"><span class="t-num">04</span> 分享包</span>
        <h2 class="section-title">复制、粘贴、发布</h2>
        <p class="section-lede">为快速分享而备的文案与素材，一切皆可直接复制。</p>
      </div>

      <div class="share-grid reveal">
        <div class="card share-card">
          <h3 class="share-title">安装命令</h3>
          <CopyCommand command={INSTALL_CMD} size="sm" />
        </div>
        <div class="card share-card">
          <h3 class="share-title">一句话标语</h3>
          <CopyCommand command={tagline} size="sm" />
        </div>
        <div class="card share-card share-wide">
          <h3 class="share-title">现成的发布文案</h3>
          <CopyCommand command={shareLine} size="sm" />
        </div>
        <div class="card share-card">
          <h3 class="share-title">品牌素材</h3>
          <div class="asset-links">
            <a href="/docs-cn/agent-skills/favicon.svg" download class="dl-btn">Logo SVG</a>
            <a href="/docs-cn/agent-skills/og.png" download class="dl-btn">社交分享卡 PNG</a>
            <a href={REPO} target="_blank" rel="noopener" class="dl-btn">GitHub ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- STICKERS -->
  <section class="section" id="stickers">
    <div class="container">
      <div class="t-head reveal">
        <span class="eyebrow"><span class="t-num">05</span> 贴纸</span>
        <h2 class="section-title">打印属于你的“I got agent skills”贴纸</h2>
        <p class="section-lede">
          四款透明底、可直送异形裁切的设计，各备两种分辨率：300 DPI（2508&times;2508）覆盖绝大多数贴纸印刷场景，600 DPI（5016&times;5016）留给对精度有额外要求的印刷商。两种分辨率最高都能在约 8 in / 21 cm 的尺寸内保持清晰。下载一张，上传到你常用的贴纸印刷服务（Sticker Mule、Vistaprint 或本地打印店），然后贴在你手边最近的笔记本电脑上。
        </p>
      </div>

      <div class="sticker-grid reveal">
        {stickers.map((s) => (
          <article class="card sticker-card" style={`--h:${s.hue}`}>
            <div class="sticker-frame">
              <img
                src={`/docs-cn/agent-skills/teach/stickers/${s.slug}-preview.webp`}
                alt={`“I got agent skills”贴纸——${s.title}`}
                loading="lazy"
                width="640"
                height="640"
              />
            </div>
            <div class="sticker-meta">
              <div class="sticker-text">
                <h3 class="sticker-title">{s.title}</h3>
                <p class="sticker-blurb">{s.blurb}</p>
              </div>
              <div class="sticker-dl">
                <div class="dl-group">
                  <span class="dl-group-label mono">300 DPI</span>
                  <a href={`/docs-cn/agent-skills/teach/stickers/${s.slug}.png`} download class="dl-btn">PNG &middot; {s.pngSize}</a>
                  <a href={`/docs-cn/agent-skills/teach/stickers/${s.slug}.webp`} download class="dl-btn">WebP &middot; {s.webpSize}</a>
                </div>
                <div class="dl-group">
                  <span class="dl-group-label mono">600 DPI</span>
                  <a href={`/docs-cn/agent-skills/teach/stickers/${s.slug}-600dpi.png`} download class="dl-btn">PNG &middot; {s.png600Size}</a>
                  <a href={`/docs-cn/agent-skills/teach/stickers/${s.slug}-600dpi.webp`} download class="dl-btn">WebP &middot; {s.webp600Size}</a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="sticker-note">
        印刷小贴士：选择“异形裁切（die-cut）”，印刷商会沿贴纸轮廓自动裁切。透明底 PNG 到处都稳妥；WebP 是同一张图的更小文件，前提是你的印刷商支持。多数服务要求 300 DPI；大幅印刷或挑剔的印刷商就选 600 DPI。
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section t-cta">
    <div class="container t-cta-inner reveal">
      <h2 class="t-cta-title">用这些素材做出了作品？</h2>
      <p class="t-cta-sub">给项目打上标签，让更多人找到它。这里的一切皆采用 MIT 许可，可自由复用。</p>
      <div class="t-cta-links">
        <a href="/docs-cn/agent-skills/docs/getting-started/" class="btn btn-primary">开始使用</a>
        <a href={REPO} target="_blank" rel="noopener" class="btn btn-secondary">在 GitHub 上加星</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .t-hero {
    position: relative;
    padding-block: clamp(52px, 9vw, 96px) 40px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .t-hero-glow {
    position: absolute;
    top: -200px;
    left: 30%;
    width: 720px;
    height: 480px;
    background: radial-gradient(50% 50% at 50% 50%, rgba(82, 168, 255, 0.12), transparent 70%);
    pointer-events: none;
  }
  .t-hero-inner {
    position: relative;
    max-width: 760px;
  }
  .t-h1 {
    margin-top: 16px;
    font-size: clamp(2.1rem, 5.2vw, 3.2rem);
    letter-spacing: -0.03em;
    line-height: 1.03;
  }
  .t-lede {
    margin-top: 18px;
    color: var(--fg-muted);
    font-size: clamp(1rem, 1.7vw, 1.16rem);
    line-height: 1.6;
    max-width: 660px;
  }
  .t-hero-cta {
    margin-top: 28px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .t-head {
    max-width: 720px;
    margin-bottom: 44px;
  }
  .t-head .section-title {
    margin-top: 16px;
  }
  .t-num {
    color: var(--fg-faint);
  }

  /* Decks */
  .deck-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .deck-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    overflow: hidden;
  }
  .deck-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, hsl(var(--h) 70% 60%), transparent);
  }
  .deck-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .deck-level {
    font-size: 1.5rem;
    font-weight: 600;
    color: hsl(var(--h) 60% 70%);
    letter-spacing: -0.02em;
  }
  .deck-slides {
    font-size: 12px;
    color: var(--fg-faint);
  }
  .deck-title {
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }
  .deck-blurb {
    margin-top: 10px;
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .deck-covers {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex: 1;
  }
  .deck-covers li {
    position: relative;
    padding-left: 18px;
    color: var(--fg-dim);
    font-size: 0.84rem;
  }
  .deck-covers li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 8px;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: hsl(var(--h) 65% 58%);
  }
  .deck-actions {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }
  .deck-btn {
    height: 40px;
    flex: 1;
    font-size: 0.88rem;
  }

  /* Diagrams */
  .diagram-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .diagram-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
  }
  .diagram-frame {
    display: block;
    border-bottom: 1px solid var(--border);
    background: #000;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .diagram-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s var(--ease);
  }
  .diagram-card:hover .diagram-frame img {
    transform: scale(1.02);
  }
  .diagram-meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px 20px;
  }
  .diagram-title {
    font-size: 1.02rem;
  }
  .diagram-blurb {
    margin-top: 6px;
    color: var(--fg-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    max-width: 42ch;
  }
  .diagram-dl {
    display: flex;
    gap: 8px;
    flex: none;
  }
  .dl-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding-inline: 12px;
    border-radius: var(--r-sm);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    transition: all 0.15s;
  }
  .dl-btn:hover {
    color: var(--fg-bright);
    border-color: var(--border-hover);
    background: var(--surface-2);
  }

  /* Modes */
  .modes {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .mode-row {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 32px;
    align-items: center;
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
  }
  .mode-row[data-flip='true'] .mode-figure {
    order: 2;
  }
  .mode-figure {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #000;
    aspect-ratio: 16 / 9;
  }
  .mode-figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mode-label {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--h) 60% 70%);
  }
  .mode-headline {
    margin-top: 10px;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }
  .mode-body {
    margin-top: 12px;
    color: var(--fg-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }
  .mode-points {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .mode-points li {
    position: relative;
    padding-left: 20px;
    color: var(--fg-dim);
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .mode-points li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 8px;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: hsl(var(--h) 65% 58%);
  }

  /* Share */
  .share-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .share-card {
    padding: 22px;
  }
  .share-wide {
    grid-column: 1 / -1;
  }
  .share-title {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-dim);
    font-weight: 500;
    margin-bottom: 14px;
  }
  .asset-links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .asset-links .dl-btn {
    height: 36px;
  }

  /* Stickers */
  .sticker-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .sticker-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
  }
  .sticker-frame {
    display: grid;
    place-items: center;
    padding: 28px;
    border-bottom: 1px solid var(--border);
    background:
      repeating-conic-gradient(rgba(255, 255, 255, 0.035) 0% 25%, transparent 0% 50%)
      0 0 / 28px 28px,
      var(--surface-2, rgba(255, 255, 255, 0.02));
  }
  .sticker-frame img {
    width: min(100%, 320px);
    height: auto;
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.45));
    transition: transform 0.3s var(--ease);
  }
  .sticker-card:hover .sticker-frame img {
    transform: scale(1.03) rotate(-1.5deg);
  }
  .sticker-meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px 20px;
  }
  .sticker-title {
    font-size: 1.02rem;
  }
  .sticker-blurb {
    margin-top: 6px;
    color: var(--fg-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    max-width: 34ch;
  }
  .sticker-dl {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: none;
  }
  .dl-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dl-group-label {
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--fg-faint);
    width: 52px;
    text-align: right;
    flex: none;
  }
  .sticker-note {
    margin-top: 20px;
    color: var(--fg-dim);
    font-size: 0.85rem;
    line-height: 1.55;
    max-width: 68ch;
  }

  /* CTA */
  .t-cta {
    text-align: center;
  }
  .t-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .t-cta-title {
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    letter-spacing: -0.02em;
  }
  .t-cta-sub {
    margin-top: 12px;
    color: var(--fg-muted);
    max-width: 480px;
  }
  .t-cta-links {
    margin-top: 24px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .deck-grid {
      grid-template-columns: 1fr;
    }
    .mode-row {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .mode-row[data-flip='true'] .mode-figure {
      order: 0;
