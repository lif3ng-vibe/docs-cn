---
import Base from '../../layouts/Base.astro';
import CopyCommand from '../../components/CopyCommand.astro';
import { tutorials } from '../../data/tutorials';
import { getSkill } from '../../data/skills';

export function getStaticPaths() {
  return tutorials.map((t) => ({ params: { slug: t.slug }, props: { tutorial: t } }));
}

const { tutorial } = Astro.props;
const idx = tutorials.findIndex((t) => t.slug === tutorial.slug);
const next = tutorials[idx + 1];
const skillName = (slug?: string) => (slug && getSkill(slug) ? getSkill(slug)!.name : slug);
---

<Base
  title={`${tutorial.title} - agent-skills 实战教程`}
  description={tutorial.summary}
>
  <article class="tt" style={`--h:${tutorial.hue}`}>
    <div class="tt-hero-bg grid-bg"></div>
    <div class="container tt-head">
      <nav class="crumbs" aria-label="面包屑导航">
        <a href="/docs-cn/agent-skills/tutorials/">实战教程</a>
        <span aria-hidden="true">/</span>
        <span class="crumb-cur">{tutorial.scenario}</span>
      </nav>
      <div class="tt-top">
        <span class="tt-level mono">{tutorial.level}</span>
        <span class="chip"><span class="tt-dot"></span>{tutorial.scenario}</span>
        <span class="tt-meta mono">{tutorial.steps.length} 步 · {tutorial.time} · {tutorial.difficulty}</span>
      </div>
      <h1 class="tt-title">{tutorial.title}</h1>
      <p class="tt-intro">{tutorial.intro}</p>

      <figure class="tt-figure">
        <img src={`/docs-cn/agent-skills/teach/diagrams/${tutorial.diagram}.svg`} alt={tutorial.title} width="1280" height="720" loading="lazy" />
      </figure>
    </div>

    <div class="container tt-body">
      <aside class="tt-prereq">
        <div class="prereq-card">
          <h2 class="prereq-title">开始之前</h2>
          <ul class="prereq-list">
            {tutorial.prereqs.map((p) => <li>{p}</li>)}
          </ul>
          <p class="prereq-note">
            每一步都带一段可复制的提示词，在任何智能体里都能用。在 Claude Code 里斜杠命令更快；在
            Codex 里用 <code>@name</code> 按名字调用技能。
          </p>
        </div>
      </aside>

      <div class="tt-steps">
        {tutorial.steps.map((s, i) => (
          <section class="step" id={`step-${s.n}`}>
            <div class="step-rail">
              <span class="step-n mono">{s.n}</span>
              {i < tutorial.steps.length - 1 && <span class="step-line"></span>}
            </div>
            <div class="step-body">
              <div class="step-tophead">
                <h2 class="step-title">{s.title}</h2>
                <div class="step-chips">
                  {s.command && <span class="step-cmd mono">{s.command}</span>}
                  {s.skill && (
                    <a href={`/docs-cn/agent-skills/skills/${s.skill}/`} class="step-skill mono">{skillName(s.skill)}</a>
                  )}
                </div>
              </div>

              <div class="step-prompt">
                <CopyCommand command={s.prompt} prompt="›" size="sm" label="提示词（粘贴进你的智能体）" />
              </div>

              <div class="step-grid">
                <div class="step-cell">
                  <span class="step-cell-label">会发生什么</span>
                  <p>{s.does}</p>
                </div>
                <div class="step-cell">
                  <span class="step-cell-label accent">为什么重要</span>
                  <p>{s.why}</p>
                </div>
              </div>

              {s.tip && (
                <div class="step-tip">
                  <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true"><path d="M8.5 1.5 2.5 9h4l-1 5.5 6-7.5h-4l1-5.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
                  <span><b>更快路径。</b> {s.tip}</span>
                </div>
              )}

              {s.checkpoint && (
                <div class="step-check">
                  <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.4" stroke="currentColor" stroke-width="1.2"/><path d="m5.4 8.2 1.7 1.7L11 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span><b>检查点。</b> {s.checkpoint}</span>
                </div>
              )}
            </div>
          </section>
        ))}
      </div>
    </div>

    <div class="container tt-outcome-wrap">
      <div class="tt-outcome">
        <span class="eyebrow">你最终会得到</span>
        <p class="tt-outcome-text">{tutorial.outcome}</p>
        <div class="recap">
          {tutorial.recap.map((r) => (
            <div class="recap-row">
              <a href={`/docs-cn/agent-skills/skills/${r.skill}/`} class="recap-skill mono">{skillName(r.skill)}</a>
              <span class="recap-arrow" aria-hidden="true">→</span>
              <span class="recap-got">{r.got}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="tt-next">
        {next ? (
          <a href={`/docs-cn/agent-skills/tutorials/${next.slug}/`} class="tt-next-card card" style={`--h:${next.hue}`}>
            <span class="tt-next-label mono">下一篇教程</span>
            <span class="tt-next-title">{next.title}</span>
            <span class="tt-next-arrow" aria-hidden="true">→</span>
          </a>
        ) : (
          <a href="/docs-cn/agent-skills/loops/" class="tt-next-card card" style={`--h:145`}>
            <span class="tt-next-label mono">更进一步</span>
            <span class="tt-next-title">回路工程指南</span>
            <span class="tt-next-arrow" aria-hidden="true">→</span>
          </a>
        )}
        <a href="/docs-cn/agent-skills/skills/" class="tt-next-card card ghost">
          <span class="tt-next-label mono">参考</span>
          <span class="tt-next-title">浏览全部 24 个技能</span>
          <span class="tt-next-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </article>
</Base>

<style>
  .tt {
    position: relative;
  }
  .tt-hero-bg {
    height: 340px;
    inset: 0 0 auto 0;
    opacity: 0.7;
  }
  .tt-head {
    position: relative;
    padding-block: 40px 8px;
    max-width: 860px;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 0.85rem;
    color: var(--fg-dim);
    margin-bottom: 24px;
  }
  .crumbs a:hover {
    color: var(--fg-bright);
  }
  .crumb-cur {
    color: hsl(var(--h) 55% 74%);
  }
  .tt-top {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .tt-level {
    font-size: 0.78rem;
    color: hsl(var(--h) 55% 72%);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .tt-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: hsl(var(--h) 70% 60%);
    box-shadow: 0 0 8px hsl(var(--h) 80% 60% / 0.6);
  }
  .tt-meta {
    font-size: 0.76rem;
    color: var(--fg-faint);
  }
  .tt-title {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .tt-intro {
    margin-top: 18px;
    color: var(--fg-muted);
    font-size: clamp(1.02rem, 1.6vw, 1.14rem);
    line-height: 1.62;
  }
  .tt-figure {
    margin: 32px 0 0;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #000;
  }
  .tt-figure img {
    width: 100%;
    height: auto;
    display: block;
  }

  .tt-body {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 40px;
    align-items: start;
    padding-block: 40px;
    max-width: 1000px;
  }
  .tt-prereq {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }
  .prereq-card {
    padding: 22px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }
  .prereq-title {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-dim);
    font-weight: 500;
  }
  .prereq-list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .prereq-list li {
    position: relative;
    padding-left: 18px;
    color: var(--fg-muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .prereq-list li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 8px;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: hsl(var(--h) 65% 58%);
  }
  .prereq-note {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    color: var(--fg-dim);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .prereq-note code {
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .tt-steps {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .step {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 18px;
  }
  .step-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 999px;
    border: 1px solid hsl(var(--h) 50% 50% / 0.5);
    background: hsl(var(--h) 50% 50% / 0.08);
    color: hsl(var(--h) 60% 74%);
    font-size: 0.9rem;
  }
  .step-line {
    width: 1px;
    flex: 1;
    background: var(--border);
    margin: 8px 0;
  }
  .step-body {
    padding-bottom: 34px;
    min-width: 0;
  }
  .step-tophead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .step-title {
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }
  .step-chips {
    display: flex;
    gap: 8px;
    flex: none;
  }
  .step-cmd {
    font-size: 0.78rem;
    color: var(--accent);
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 3px 9px;
    border-radius: 999px;
  }
  .step-skill {
    font-size: 0.78rem;
    color: hsl(var(--h) 55% 74%);
    background: hsl(var(--h) 50% 50% / 0.1);
    border: 1px solid hsl(var(--h) 50% 50% / 0.25);
    padding: 3px 9px;
    border-radius: 999px;
    transition: background 0.15s;
  }
  .step-skill:hover {
    background: hsl(var(--h) 50% 50% / 0.2);
  }
  .step-prompt {
    margin-bottom: 18px;
  }
  .step-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .step-cell {
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
  }
  .step-cell-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .step-cell-label.accent {
    color: hsl(var(--h) 55% 70%);
  }
  .step-cell p {
    margin-top: 8px;
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .step-tip {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 14px;
    padding: 12px 14px;
    background: rgba(82, 168, 255, 0.06);
    border: 1px solid rgba(82, 168, 255, 0.22);
    border-radius: var(--r-md);
    color: var(--fg-muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .step-tip svg {
    flex: none;
    margin-top: 2px;
    color: var(--accent);
  }
  .step-tip b {
    color: var(--accent);
    font-weight: 500;
  }
  .step-check {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 14px;
    padding: 12px 14px;
    background: hsl(var(--h) 40% 45% / 0.06);
    border: 1px solid hsl(var(--h) 40% 50% / 0.2);
    border-radius: var(--r-md);
    color: var(--fg-muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .step-check svg {
    flex: none;
    margin-top: 2px;
    color: hsl(var(--h) 60% 66%);
  }
  .step-check b {
    color: var(--fg);
    font-weight: 500;
  }

  .tt-outcome-wrap {
    padding-block: 8px 96px;
    max-width: 1000px;
  }
  .tt-outcome {
    padding: clamp(28px, 4vw, 40px);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
  }
  .tt-outcome-text {
    margin-top: 14px;
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--fg);
    max-width: 720px;
  }
  .recap {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .recap-row {
    display: grid;
    grid-template-columns: 260px 24px 1fr;
    align-items: center;
    gap: 10px;
    padding: 13px 16px;
    background: var(--surface);
  }
  .recap-skill {
    font-size: 0.86rem;
    color: hsl(var(--h) 55% 74%);
  }
  .recap-skill:hover {
    color: var(--fg-bright);
  }
  .recap-arrow {
    color: var(--fg-faint);
  }
  .recap-got {
    color: var(--fg-muted);
    font-size: 0.9rem;
  }

  .tt-next {
    margin-top: 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .tt-next-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px;
    position: relative;
  }
  .tt-next-label {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--h) 55% 70%);
  }
  .tt-next-card.ghost .tt-next-label {
    color: var(--fg-faint);
  }
  .tt-next-title {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--fg-bright);
  }
  .tt-next-arrow {
    position: absolute;
    top: 22px;
    right: 22px;
    color: var(--fg-dim);
    transition: transform 0.2s var(--ease);
  }
  .tt-next-card:hover .tt-next-arrow {
    transform: translateX(3px);
    color: var(--fg-bright);
  }

  @media (max-width: 900px) {
    .tt-body {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .tt-prereq {
      position: static;
    }
  }
  @media (max-width: 620px) {
    .step-grid {
      grid-template-columns: 1fr;
    }
    .recap-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .recap-arrow {
      display: none;
    }
    .tt-next {
      grid-template-columns: 1fr;
    }
  }
</style>
