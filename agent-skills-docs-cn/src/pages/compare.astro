---
import Base from '../layouts/Base.astro';
import { REPO_URL } from '../data/skills';

const cols = ['agent-skills', 'Superpowers', 'Matt Pocock’s skills'];
const rows = [
  {
    label: '核心理念',
    values: [
      '把资深工程师的完整工程生命周期编码为技能',
      '一套建立在可组合技能之上的完整开发方法论',
      '一位专家的 Claude Code 工作流，开源分享',
    ],
  },
  {
    label: '组织原则',
    values: [
      '软件开发生命周期（SDLC）各阶段（定义 → 上线）由元技能路由驱动',
      '一条纪律严明的单一回路：头脑风暴、规划、执行、评审',
      '一个精选工具箱，命令聚焦且可组合',
    ],
  },
  {
    label: '目录规模',
    values: ['覆盖完整生命周期的 24 个技能', '约 14 个技能，深耕构建内环', '约 30 个技能，按领域分组'],
  },
  {
    label: '生命周期覆盖',
    values: [
      '广：创意 → API/UI → 安全 → 性能 → CI/CD → 可观测性 → 发布',
      '深而窄：TDD、调试、规划、评审、技能编写',
      '定义与构建偏重：grilling、PRD、issue 处理、TDD、分诊',
    ],
  },
  {
    label: '独特机制',
    values: [
      '每个技能内置反合理化表 + Red Flags；并行评审角色（persona）；参考清单；CI 内的三层 evals（评估套件）框架',
      '子智能体驱动开发，配任务评审者与修复回路；git worktree 隔离；会写技能的技能',
      'grilling 原语；基于接缝（seam）的 TDD；显式区分用户调用与模型调用',
    ],
  },
  {
    label: '质量度量',
    values: [
      '针对目录的触发、路由与行为 evals（部分跑在 CI）',
      '压力测试是核心；evals（评估套件）放在独立仓库',
      '仓库内未随附 evals',
    ],
  },
  {
    label: '最适合',
    values: [
      '带着逐阶段检查点，把一个功能推进过每个阶段',
      '长周期、自主、重推理或探索性的工作',
      '务实、经实战检验的日常回路——在需求与 TDD 上最强',
    ],
  },
];

const projects = [
  {
    name: 'Superpowers',
    by: 'obra / Jesse Vincent',
    href: 'https://github.com/obra/superpowers',
    body: '一套押注自主性与前置推理的完整开发方法论。一次会话运行刻意保持线性的流水线——苏格拉底式头脑风暴、可执行的计划，然后是子智能体驱动的执行，每个任务收尾前都有任务评审者签字确认。Git worktree 隔离并行工作。当你交出一大块工作、想拿回一份经过评审的结果时，它表现出色；在小改动上则偏重。',
  },
  {
    name: 'Matt Pocock’s skills',
    by: 'mattpocock',
    href: 'https://github.com/mattpocock/skills',
    body: '一位顶尖工程师真正在用的 Claude Code 技能集，以公开方式开发，in-progress/ 与 deprecated/ 目录一目了然。重心是 grilling——一个可复用的“一次只问一个问题”的盘问回路。真实而犀利；实践上以 Claude Code 为先，构建（Build）之后的覆盖较薄，仓库内也没有 evals。',
  },
];
---

<Base
  title="横向对比 - agent-skills"
  description="一张诚实并排的对比图：agent-skills vs Superpowers 与 Matt Pocock’s skills。脱离具体场景没有谁最好——取决于你手头的工作。"
>
  <section class="cmp-hero">
    <div class="grid-bg"></div>
    <div class="container cmp-hero-inner">
      <span class="eyebrow">诚实的定位</span>
      <h1 class="cmp-h1">agent-skills 的横向对比</h1>
      <p class="cmp-lede">
        经常有人问它与大家最常听到的另外两个技能集——<strong>Superpowers</strong> 和
        <strong>Matt Pocock’s skills</strong>——是什么关系。三者都很优秀、共享同一血统，也都值得学习。这是一张诚实的地图，讲清它们各自的
        <em>形态</em>差异，方便你选出合适的——或者三家都取经。
      </p>
      <div class="cmp-tldr">
        <span class="cmp-tldr-tag mono">TL;DR</span>
        <p>
          它们各自为不同的时刻优化。<strong>agent-skills</strong> 用评审角色、反合理化护栏和仓库内
          evals（评估套件）框架来组织整个生命周期。<strong>Superpowers</strong>
          倾向自主、重推理的长程运行。<strong>Matt Pocock’s skills</strong>
          则是一套犀利、有主见的日常工具箱，招牌是“grill me”盘问回路。
        </p>
      </div>
    </div>
  </section>

  <section class="container cmp-section">
    <h2 class="cmp-h2">一览</h2>
    <div class="table-scroll">
      <table class="cmp-table">
        <thead>
          <tr>
            <th></th>
            {cols.map((c, i) => (
              <th class:list={{ own: i === 0 }}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.values.map((v, i) => (
                <td class:list={{ own: i === 0 }}>{v}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="cmp-note">
      我们刻意略去 star 数与采用率数据——各家引用口径天差地别，而且每周都在变。三者都在被积极使用和维护。
    </p>
  </section>

  <section class="container cmp-section">
    <h2 class="cmp-h2">另外两家，用它们自己的话说</h2>
    <div class="proj-grid">
      {projects.map((p) => (
        <article class="card proj-card">
          <div class="proj-head">
            <h3>{p.name}</h3>
            <span class="proj-by">{p.by}</span>
          </div>
          <p class="proj-body">{p.body}</p>
          <a href={p.href} target="_blank" rel="noopener" class="proj-link">
            查看仓库
            <svg viewBox="0 0 16 16" fill="none"><path d="M5 3.5h7.5V11M12.5 3.5 3.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="container cmp-section">
    <div class="h2h card">
      <span class="eyebrow">一场真刀真枪的对决</span>
      <h2 class="cmp-h2">Superpowers vs. agent-skills：同一仓库、同一提示词</h2>
      <p class="h2h-body">
        Om Mishra 做了一次受控实验——同一模型、同一仓库、在 Claude Code
        里用同一提示词，只换技能框架。agent-skills 更快进入编码（约 8 分钟 vs 约 12 分钟），并跑了
        <strong>更多轮验证</strong>（7 轮 vs 5 轮，含完整测试套件），从而抓到了直接功能范围之外的一个兼容性问题。Superpowers
        则在前期投入了更多架构推理。Token 效率基本持平。他诚实的结论是：按任务选工具。
      </p>
      <a
        href="https://www.linkedin.com/pulse/superpowers-vs-agent-skills-faster-shipping-safer-reasoning-om-mishra-dzakf/"
        target="_blank"
        rel="noopener"
        class="btn btn-secondary"
      >
        阅读完整文章
        <svg viewBox="0 0 16 16" fill="none"><path d="M5 3.5h7.5V11M12.5 3.5 3.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <section class="container cmp-cta">
    <hr class="hairline" />
    <div class="cmp-cta-inner">
      <div>
        <h2 class="cmp-h2">阅读完整对比</h2>
        <p class="cmp-p">完整的对比文章逐阶段讲清实践中如何抉择。</p>
      </div>
      <a href={`${REPO_URL}/blob/main/docs/comparison.md`} target="_blank" rel="noopener" class="btn btn-primary">
        GitHub 上的完整对比
        <svg viewBox="0 0 16 16" fill="none"><path d="M5 3.5h7.5V11M12.5 3.5 3.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>
</Base>

<style>
  .cmp-hero {
    position: relative;
    padding-block: clamp(48px, 8vw, 84px) 40px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .cmp-hero-inner {
    position: relative;
    max-width: 760px;
  }
  .cmp-h1 {
    margin-top: 16px;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
  }
  .cmp-lede {
    margin-top: 16px;
    color: var(--fg-muted);
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    line-height: 1.6;
  }
  .cmp-lede strong {
    color: var(--fg);
  }
  .cmp-tldr {
    margin-top: 26px;
    display: flex;
    gap: 16px;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }
  .cmp-tldr-tag {
    flex: none;
    height: 22px;
    padding-inline: 9px;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: rgba(82, 168, 255, 0.1);
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .cmp-tldr p {
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .cmp-tldr strong {
    color: var(--fg-bright);
  }

  .cmp-section {
    padding-block: 48px;
  }
  .cmp-h2 {
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }
  .cmp-table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: 0.86rem;
  }
  .cmp-table th,
  .cmp-table td {
    padding: 14px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
  }
  .cmp-table thead th {
    background: var(--bg-subtle);
    color: var(--fg-bright);
    font-weight: 600;
    font-size: 0.9rem;
    position: sticky;
    top: 0;
  }
  .cmp-table thead th.own {
    color: var(--accent);
  }
  .cmp-table tbody th {
    color: var(--fg-dim);
    font-weight: 500;
    width: 160px;
    white-space: nowrap;
  }
  .cmp-table td {
    color: var(--fg-muted);
    line-height: 1.5;
  }
  .cmp-table td.own {
    color: var(--fg);
    background: rgba(82, 168, 255, 0.03);
  }
  .cmp-table tbody tr:last-child th,
  .cmp-table tbody tr:last-child td {
    border-bottom: 0;
  }
  .cmp-note {
    margin-top: 18px;
    color: var(--fg-faint);
    font-size: 0.84rem;
    line-height: 1.55;
    max-width: 620px;
  }

  .proj-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .proj-card {
    padding: 26px;
  }
  .proj-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }
  .proj-head h3 {
    font-size: 1.2rem;
  }
  .proj-by {
    color: var(--fg-faint);
    font-size: 0.82rem;
    font-family: var(--font-mono);
  }
  .proj-body {
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .proj-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    color: var(--fg-muted);
    font-size: 0.88rem;
  }
  .proj-link:hover {
    color: var(--fg-bright);
  }
  .proj-link svg {
    width: 13px;
    height: 13px;
  }

  .h2h {
    padding: clamp(28px, 4vw, 44px);
    background: var(--bg-subtle);
  }
  .h2h-body {
    margin-top: 12px;
    color: var(--fg-muted);
    font-size: 0.98rem;
    line-height: 1.7;
    max-width: 720px;
  }
  .h2h-body strong {
    color: var(--fg-bright);
  }
  .h2h .btn {
    margin-top: 24px;
  }

  .cmp-cta {
    padding-block: 24px 88px;
  }
  .cmp-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 48px;
  }
  .cmp-p {
    margin-top: 8px;
    color: var(--fg-muted);
  }

  @media (max-width: 720px) {
    .proj-grid {
      grid-template-columns: 1fr;
    }
    .cmp-tldr {
      flex-direction: column;
      gap: 12px;
    }
    .cmp-cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
