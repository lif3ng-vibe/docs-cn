---
import Base from '../layouts/Base.astro';
import { REPO_URL } from '../data/skills';

// From prompting to loops: the five primitives, and where skills sit.
const primitives = [
  { name: '自动化', job: '按计划做发现与分诊', tools: 'Codex Automations · Claude Code /loop, cron, hooks' },
  { name: '工作树', job: '隔离并行的工作，让智能体互不打架', tools: 'git worktree · isolation: worktree' },
  { name: '技能', job: '固化项目知识，以及让“完成”二字有分量的检查', tools: 'SKILL.md、本技能包', highlight: true },
  { name: '连接器', job: '让回路能在你的真实工具里动手', tools: 'MCP 服务器、插件' },
  { name: '子智能体', job: '让制造者与检查者彼此分离', tools: '.claude/agents · .codex/agents' },
  { name: '状态', job: '跨运行记住哪些事已经做完', tools: 'Markdown、一个 Linear 看板' },
];

// Autonomy ladder: how much you delegate, and what agent-skills does at each rung.
const ladder = [
  {
    rung: '交互式',
    where: '人在内层回路里',
    cmds: '/spec · /plan · /build · /review',
    body: '你驱动每一个阶段，步步都要你批准。技能负责组织工作、强制验证；每一个结果你都亲自读。面对陌生或高风险的代码，你正是在这里建立理解的。',
    hue: 205,
  },
  {
    rung: '受监督的自主',
    where: '人守在计划门禁和失败点',
    cmds: '/build auto',
    body: '你只批准一次计划，然后智能体一口气实现所有任务。它保持测试驱动、按任务提交，遇到失败或高风险步骤会暂停。你省掉的是任务之间的人工挪步，不是验证。',
    hue: 40,
  },
  {
    rung: '无人值守回路',
    where: '人守在边界上评审证据',
    cmds: '你的框架的 /loop 或 /goal，包在技能外面',
    body: '由你所用框架里的一个回路原语（它不属于本技能包——Claude Code 的 /loop，或 Claude Code 与 Codex 里“跑到完成为止”的 /goal）按节奏运行技能，或一直运行到某个可验证的停止条件成立为止，再由一个独立的检查者给结果打分。你评审证据、给出裁决。只有对那些你能又便宜又可靠地验证的回路，才配得上这一档。',
    hue: 145,
  },
];

const lightsOff = [
  '检查便宜、高频、难造假：一个绿红判官',
  'test-driven-development：测试套件要么过、要么不过',
  'browser-testing-with-devtools 与 performance-optimization：Core Web Vitals 指标要么达标、要么不达标',
  'code-review-and-quality 由一个子智能体按真实评分口径执行',
  '回路很短（大约三到十步），错误没有角落可藏',
];

const lightsOn = [
  '答错的代价高昂，而且只有人抓得住',
  'security-and-hardening：认证、密钥、不可信输入，以及 OWASP 攻击面上的任何东西',
  'api-and-interface-design：会被 Hyrum 定律钉死的公开契约',
  '大爆炸半径、计费、迁移，或一个影响一整年工作的决策',
  '存活在旧伤疤里、而不在代码里的存量项目行为',
];

const costs = [
  {
    name: '认知缴械',
    body: '一个自己会跑的回路，很容易诱你对它交回的东西照单全收。技能里的反合理化表和裁决步骤，就是为了在房间里留住一个有意见的人。产出仍然是你的答案，连同附在上面的全部责任。',
  },
  {
    name: '理解债',
    body: '回路越快上线你没写过的代码，实际存在的东西和你理解的东西之间的差距就越大。抽样和阅读是你还债的方式。顺滑的回路会让这笔债涨得更快，而测试一路全绿。',
  },
  {
    name: '编排税',
    body: '拉起很多个智能体很容易，你的评审带宽却不能并行扩展。你能同时跑多少个回路，真正的天花板是你的注意力，而不是工具。把它花在约束和危险的假设上。',
  },
];
---

<Base
  title="agent-skills 回路工程——把人留在外层回路"
  description="当你从逐轮写提示词转向设计回路、软件工厂与回路原语时，如何在 Claude Code 与 Codex 中使用 agent-skills。一个有据可依的立场：技能是回路内部的验证，于是外层回路归你。"
>
  <!-- HERO -->
  <section class="lp-hero">
    <div class="grid-bg"></div>
    <div class="container lp-hero-inner">
      <span class="eyebrow">指南 · 回路工程</span>
      <h1 class="lp-h1">把技能装进回路。<br />把自己留在外层回路。</h1>
      <p class="lp-lede">
        你与编码智能体协作的方式，正从一轮一轮地写提示词，转向<strong>设计替你向智能体发提示词的回路</strong>——自动化、工作树、子智能体，以及
        Claude Code 与 Codex 里的软件工厂。agent-skills
        正是为这一转变而生。技能就是你放进回路<em>里面</em>的验证，于是它的产出就成了你在<em>外面</em>能为之背书的证据。
      </p>
    </div>
  </section>

  <!-- THE SHIFT -->
  <section class="container lp-section">
    <div class="lp-head">
      <span class="eyebrow"><span class="lp-num">01</span> 转变</span>
      <h2 class="lp-h2">从提示词到回路</h2>
    </div>
    <div class="lp-prose">
      <p>
        领导 Anthropic Claude Code 的 Boris Cherny 说得很直白：<em>“我已经不再直接向
        Claude 发提示词了。我有一堆回路在跑，由它们向 Claude 发提示词、想清楚要做什么。我的工作就是写回路。”</em>一个回路就是一个智能体反复做同一件工作：收集上下文、动手、检查结果，然后重来，直到某个条件满足。回路叠起来就是一座软件工厂——许多被套上缰绳的回路汇入一道评审门禁，而一个人从上面掌管全局。
      </p>
      <p>
        一个回路需要五个原语，外加一个存放状态的地方——Claude Code 和 Codex
        如今两者都齐了。技能是五者之一。它在回路里的职责很具体，也是这个技能包在此有意义的原因：<strong>它们把智能体原本只能瞎猜的项目知识固化下来，并把那些让“完成”二字有分量的检查一并固化。</strong>
      </p>
    </div>

    <div class="prim-table">
      {primitives.map((p) => (
        <div class:list={['prim-row', { hi: p.highlight }]}>
          <span class="prim-name mono">{p.name}</span>
          <span class="prim-job">{p.job}</span>
          <span class="prim-tools mono">{p.tools}</span>
        </div>
      ))}
    </div>
  </section>

  <hr class="hairline" />

  <!-- MENTAL MODEL + DIAGRAM -->
  <section class="container lp-section">
    <div class="lp-head">
      <span class="eyebrow"><span class="lp-num">02</span> 心智模型</span>
      <h2 class="lp-h2">智能体跑内层回路，外层回路归你。</h2>
      <p class="lp-sub">
        系统之内只有一种东西：能力——调查、实现、验证、循环往复。系统之外也只有一种东西：主动权——决策、验证、批准、担责。两者之间的边界，是证据。
      </p>
    </div>

    <figure class="lp-figure">
      <a href="/docs-cn/agent-skills/teach/diagrams/inner-outer-loop.svg" target="_blank" rel="noopener">
        <img src="/docs-cn/agent-skills/teach/diagrams/inner-outer-loop.svg" alt="智能体跑内层回路，外层回路归你，证据跨过边界" width="1280" height="720" loading="lazy" />
      </a>
      <figcaption>
        技能住在回路内部，强制执行验证。跨过边界的只有证据——diff、测试、日志。你留在约束、抽样、审计与归属这几个回路里，裁决权始终在你手上。
        <a href="/docs-cn/agent-skills/teach/diagrams/inner-outer-loop.svg" download class="fig-dl">SVG</a>
        <a href="/docs-cn/agent-skills/teach/diagrams/inner-outer-loop.png" download class="fig-dl">PNG</a>
      </figcaption>
    </figure>

    <div class="lp-prose">
      <p>
        信任回路不等于把人拿掉，而是人不必再待在<em>内层</em>回路里。你挪到只有人能握住的那几个回路上：该定哪些约束和不变量、产出该抽样读多少、该留存并能讲清哪些证据、生产边界上哪一块归你所有。智能体能上线的量会超出你能评审的量，所以稀缺资源是你的判断力——它由技能产出的质量信号供养。
      </p>
    </div>
  </section>

  <hr class="hairline" />

  <!-- AUTONOMY LADDER -->
  <section class="container lp-section">
    <div class="lp-head">
      <span class="eyebrow"><span class="lp-num">03</span> 反向压力</span>
      <h2 class="lp-h2">只授予你验证得了的自主权</h2>
      <p class="lp-sub">
        这是工厂的铁律：交给回路的自主权，只到你能又便宜又可靠地验证的程度为止，一寸都不多给。技能里的命令，以及你包裹在它们外面的回路原语，正对应这架梯子的每一级。技能让每一级都安全，因为它们强制执行那道产出证据的检查。
      </p>
    </div>

    <div class="ladder">
      {ladder.map((l, i) => (
        <div class="ladder-row" style={`--h:${l.hue}`}>
          <div class="ladder-mark">
            <span class="ladder-n mono">{i + 1}</span>
            {i < ladder.length - 1 && <span class="ladder-line"></span>}
          </div>
          <div class="ladder-body">
            <div class="ladder-top">
              <h3 class="ladder-rung">{l.rung}</h3>
              <span class="ladder-cmds mono">{l.cmds}</span>
            </div>
            <span class="ladder-where">{l.where}</span>
            <p class="ladder-text">{l.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <hr class="hairline" />

  <!-- LIGHTS ON / OFF -->
  <section class="container lp-section">
    <div class="lp-head">
      <span class="eyebrow"><span class="lp-num">04</span> Which loops earn the dark</span>
      <h2 class="lp-h2">Decide where to leave the lights on</h2>
      <p class="lp-sub">
        A dark factory ships code no human has read, verified only by other machines. That is fine
        for some loops and dangerous for others. The skilled job is flipping each switch on purpose,
        not setting them all to the same mode.
      </p>
    </div>

    <div class="switch-grid">
      <div class="switch-card off">
        <div class="switch-head">
          <span class="switch-dot"></span>
          <h3>Lights out is fine when</h3>
        </div>
        <ul>{lightsOff.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="switch-card on">
        <div class="switch-head">
          <span class="switch-dot"></span>
          <h3>Keep the lights on when</h3>
        </div>
        <ul>{lightsOn.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- WORKED EXAMPLE -->
  <section class="container lp-section">
    <div class="lp-head">
      <span class="eyebrow"><span class="lp-num">05</span> A loop with skills in it</span>
      <h2 class="lp-h2">The maker and the checker are different agents</h2>
      <p class="lp-sub">
        The most useful structural move in a loop is splitting the agent that writes from the agent
        that checks. The model that wrote the code grades its own homework too kindly. This is
        exactly what <code class="ic">/ship</code> does when it fans out to review personas, and
        what <code class="ic">doubt-driven-development</code> does to any confident decision.
      </p>
    </div>

    <ol class="flow">
      <li><span class="flow-n mono">1</span><div><strong>An automation runs on a schedule.</strong> Its prompt calls a triage skill that reads yesterday’s CI failures, open issues, and recent commits, and writes findings to a state file.</div></li>
      <li><span class="flow-n mono">2</span><div><strong>Each finding opens an isolated worktree.</strong> A subagent drafts the fix following <code class="ic">incremental-implementation</code> and <code class="ic">test-driven-development</code> - thin slices, each tested and committed.</div></li>
      <li><span class="flow-n mono">3</span><div><strong>A second subagent reviews the draft.</strong> It applies <code class="ic">code-review-and-quality</code> and, where it matters, the <code class="ic">security-auditor</code> persona, against the project skills and existing tests.</div></li>
      <li><span class="flow-n mono">4</span><div><strong>Evidence crosses the boundary.</strong> The loop opens a PR with the diff, the passing tests, and a short rationale. Anything it cannot verify lands in your inbox.</div></li>
      <li><span class="flow-n mono">5</span><div><strong>You give the verdict.</strong> You read the evidence and decide: ship, block, redirect, or narrow. The state file remembers what passed, so tomorrow’s run picks up where this one stopped.</div></li>
    </ol>
    <p class="flow-note">
      You designed that once. You did not prompt any single step. And it runs the same in Codex or
      Claude Code, because the primitives are the same - the skills are the part that stays constant
      as you move between harnesses.
    </p>
  </section>

  <hr class="hairline" />

  <!-- WHAT IT DOESN'T DO -->
  <section class="container lp-section">
    <div class="lp-head">
      <span class="eyebrow"><span class="lp-num">06</span> What the loop does not do for you</span>
      <h2 class="lp-h2">Three costs that get sharper, not softer</h2>
      <p class="lp-sub">
        A loop running unattended is a loop making mistakes unattended. The skills give you back
        pressure, but "done" is a claim, not a proof. These three costs grow as the loop gets
        smoother, so design against them deliberately.
      </p>
    </div>
    <div class="costs">
      {costs.map((c) => (
        <article class="cost-card">
          <h3 class="cost-name">{c.name}</h3>
          <p class="cost-body">{c.body}</p>
        </article>
      ))}
    </div>
  </section>

  <hr class="hairline" />

  <!-- ANTHROPIC-GROUNDED -->
  <section class="container lp-section">
    <div class="lp-head">
      <span class="eyebrow"><span class="lp-num">07</span> The grounded take</span>
      <h2 class="lp-h2">What we recommend</h2>
      <p class="lp-sub">
        This is how we suggest running the skills inside loops. It lines up with widely shared
        guidance on building agents, which is part of why the skills are shaped the way they are.
      </p>
    </div>
    <div class="tenets">
      <div class="tenet">
        <h3>Prefer the simplest thing that works</h3>
        <p>Use a predefined workflow or graph where you can, and reach for open-ended autonomy only when the task genuinely needs it. A skill is a workflow with a shape you can trust, not a free-running agent.</p>
      </div>
      <div class="tenet">
        <h3>Give the agent ground truth at each step</h3>
        <p>Effective agents check progress against the environment - tool results, test runs, code execution - rather than their own say-so. Every skill ends in exactly that: evidence, not "seems right."</p>
      </div>
      <div class="tenet">
        <h3>Pause for a human where evaluation is clear</h3>
        <p>Agents should stop for human feedback at checkpoints and on blockers. The verdict step and the human checkpoint between phases are those pauses, placed where a wrong call is expensive.</p>
      </div>
      <div class="tenet">
        <h3>Understanding is not free</h3>
        <p>Anthropic’s own controlled trial found engineers who leaned on AI scored lower on comprehension of the resulting code. Reading what the loop makes is the antidote, and the reason to keep the lights on where it counts.</p>
      </div>
    </div>
    <p class="tenets-src">
      Informed by public guidance on agent design, including Anthropic’s
      <a href="https://www.anthropic.com/engineering/building-effective-agents" target="_blank" rel="noopener">Building effective agents</a>,
      <a href="https://www.anthropic.com/engineering/effective-harnesses-for-long-running-agents" target="_blank" rel="noopener">Effective harnesses for long-running agents</a>, and
      <a href="https://www.anthropic.com/research/AI-assistance-coding-skills" target="_blank" rel="noopener">research on AI assistance and coding skills</a>. References, not endorsements.
    </p>
  </section>

  <!-- CTA -->
  <section class="container lp-cta-wrap">
    <div class="lp-cta card">
      <h2 class="lp-cta-title">Build the loop. Stay the engineer.</h2>
      <p class="lp-cta-sub">
        Two people can build the same loop and get opposite results. One uses it to move faster on
        work they understand; the other to avoid understanding the work. The loop cannot tell the
        difference. You can.
      </p>
      <div class="lp-cta-links">
        <a href="/docs-cn/agent-skills/docs/getting-started/" class="btn btn-primary">Install the skills</a>
        <a href="/docs-cn/agent-skills/lifecycle/" class="btn btn-secondary">See the lifecycle</a>
      </div>
      <div class="lp-reading">
        <span class="lp-reading-label mono">Further reading</span>
        <a href="https://addyosmani.com/blog/loop-engineering/" target="_blank" rel="noopener">Loop Engineering</a>
        <a href="https://addyosmani.com/blog/own-the-outer-loop/" target="_blank" rel="noopener">Own the Outer Loop</a>
        <a href="https://addyosmani.com/blog/software-factories/" target="_blank" rel="noopener">Software Factories</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lp-hero {
    position: relative;
    padding-block: clamp(52px, 9vw, 92px) 44px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .lp-hero-inner {
    position: relative;
    max-width: 780px;
  }
  .lp-h1 {
    margin-top: 16px;
    font-size: clamp(2.1rem, 5.4vw, 3.3rem);
    letter-spacing: -0.03em;
    line-height: 1.04;
  }
  .lp-lede {
    margin-top: 20px;
    color: var(--fg-muted);
    font-size: clamp(1.02rem, 1.7vw, 1.2rem);
    line-height: 1.62;
    max-width: 680px;
  }
  .lp-lede strong {
    color: var(--fg-bright);
    font-weight: 500;
  }
  .lp-lede em,
  .lp-sub em,
  .lp-prose em {
    color: var(--fg);
    font-style: italic;
  }

  .lp-section {
    padding-block: clamp(44px, 7vw, 72px);
    max-width: 900px;
  }
  .lp-head {
    max-width: 720px;
    margin-bottom: 32px;
  }
  .lp-num {
    color: var(--fg-faint);
  }
  .lp-h2 {
    margin-top: 14px;
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    letter-spacing: -0.02em;
    line-height: 1.12;
  }
  .lp-sub {
    margin-top: 14px;
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.62;
  }
  .lp-prose p {
    color: var(--fg-muted);
    font-size: 1.02rem;
    line-height: 1.7;
    margin-bottom: 18px;
    max-width: 760px;
  }
  .lp-prose strong {
    color: var(--fg-bright);
    font-weight: 500;
  }
  .ic {
    font-family: var(--font-mono);
    color: var(--accent);
    background: var(--surface-2);
    padding: 1px 6px;
    border-radius: 5px;
    border: 1px solid var(--border);
    font-size: 0.86em;
  }

  /* Primitives table */
  .prim-table {
    margin-top: 28px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .prim-row {
    display: grid;
    grid-template-columns: 150px 1fr 240px;
    gap: 18px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    align-items: center;
  }
  .prim-row:last-child {
    border-bottom: 0;
  }
  .prim-row.hi {
    background: rgba(82, 168, 255, 0.05);
  }
  .prim-name {
    color: var(--fg-bright);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .prim-row.hi .prim-name {
    color: var(--accent);
  }
  .prim-job {
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .prim-tools {
    color: var(--fg-faint);
    font-size: 0.76rem;
    text-align: right;
  }

  /* Figure */
  .lp-figure {
    margin: 0;
  }
  .lp-figure a {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #000;
  }
  .lp-figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  figcaption {
    margin-top: 14px;
    color: var(--fg-dim);
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .fig-dl {
    display: inline-flex;
    margin-left: 8px;
    padding: 2px 9px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-muted);
  }
  .fig-dl:hover {
    color: var(--fg-bright);
    border-color: var(--border-hover);
  }
  .lp-figure + .lp-prose {
    margin-top: 28px;
  }

  /* Ladder */
  .ladder {
    display: flex;
    flex-direction: column;
  }
  .ladder-row {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 20px;
  }
  .ladder-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
