---
import Base from '../../layouts/Base.astro';
import CopyCommand from '../../components/CopyCommand.astro';
import { INSTALL_CMD, REPO_URL, totalSkills } from '../../data/skills';

const platforms = [
  {
    id: 'claude-code',
    name: 'Claude Code',
    intro: '通过 marketplace 以插件形式安装，或让 Claude 指向本地克隆。',
    steps: [
      { label: '添加 marketplace', cmd: '/plugin marketplace add addyosmani/agent-skills', prompt: '›' },
      { label: '安装插件', cmd: '/plugin install agent-skills@addy-agent-skills', prompt: '›' },
    ],
    note: '安装时遇到 SSH 报错？用完整的 HTTPS URL 添加 marketplace，或运行 `git config --global url."https://github.com/".insteadOf git@github.com:`。',
    docHref: `${REPO_URL}#claude-code-recommended`,
  },
  {
    id: 'codex',
    name: 'Codex',
    intro: '以原生 Codex 插件形式安装（Codex CLI v0.122+）。在对话中用 @ 调用技能。',
    steps: [
      { label: '添加 marketplace', cmd: 'codex plugin marketplace add addyosmani/agent-skills', prompt: '$' },
    ],
    note: 'Codex 通过 .codex-plugin/plugin.json 直接读取根目录的 skills/ 目录。',
    docHref: `${REPO_URL}/blob/main/docs/codex-setup.md`,
  },
  {
    id: 'cursor',
    name: 'Cursor',
    intro: '把工作流技能放在 .cursor/skills/ 下，把简短策略放进 .cursor/rules/*.mdc——不要把完整技能整篇粘进 rules。',
    steps: [
      { label: '通过 skills CLI 安装', cmd: INSTALL_CMD, prompt: '$' },
    ],
    note: 'rules 与 skills 的分工详见 Cursor 配置指南。',
    docHref: `${REPO_URL}/blob/main/docs/cursor-setup.md`,
  },
  {
    id: 'antigravity',
    name: 'Antigravity',
    intro: '以原生插件形式安装，覆盖技能、子智能体与斜杠命令。',
    steps: [
      { label: '从仓库安装', cmd: 'agy plugin install https://github.com/addyosmani/agent-skills.git', prompt: '$' },
    ],
    note: '本地克隆的安装方式详见 Antigravity 配置指南。',
    docHref: `${REPO_URL}/blob/main/docs/antigravity-setup.md`,
  },
  {
    id: 'others',
    name: '其他',
    intro: 'Windsurf、OpenCode、Copilot、Cline、Kiro，以及任何接受 Markdown 指令的智能体都可用。技能就是纯 Markdown。',
    steps: [
      { label: '通用——适用于 70+ 种智能体', cmd: INSTALL_CMD, prompt: '$' },
    ],
    note: '开放的 skills CLI 可安装到 70+ 种智能体。也可以把任意 SKILL.md 复制进你的 rules/系统提示词。',
    docHref: `${REPO_URL}/blob/main/docs/getting-started.md`,
  },
];

const first10 = [
  {
    n: '1',
    t: '安装技能包',
    d: '一条命令把全部 24 个技能装进你的智能体。无需任何配置——元技能会把工作路由到合适的技能。',
  },
  {
    n: '2',
    t: '从规格（spec）开始',
    d: '运行 /spec（或让智能体“遵循 spec-driven-development”）。它会在写任何代码之前先写一份简短 PRD——这是杠杆率最高的单一习惯。',
  },
  {
    n: '3',
    t: '测试先行地构建',
    d: '/build 以薄的垂直切片推进；/test 强制红-绿-重构。每个切片都单独提交、单独验证。',
  },
  {
    n: '4',
    t: '合并前先评审',
    d: '/review 运行五轴质量门禁。/ship 展开各专家评审角色（persona），最终给出放行/叫停（go/no-go）。',
  },
];
---

<Base
  title="快速上手 - agent-skills"
  description="把 agent-skills 安装到 Claude Code、Codex、Cursor 以及 70+ 种其他智能体。一条命令，然后是你的头 10 分钟。"
>
  <div class="doc-hero">
    <div class="grid-bg"></div>
    <div class="container doc-hero-inner">
      <span class="eyebrow">文档</span>
      <h1 class="doc-h1">一分钟内即可上手</h1>
      <p class="doc-lede">
        最快的路径适用于任何智能体——用开放的
        <a href="https://github.com/vercel-labs/skills" target="_blank" rel="noopener">skills CLI</a>
        一条命令搞定，可安装到 70+ 种工具。偏好原生集成？在下方选择你的工具。
      </p>
      <div class="doc-hero-cmd">
        <CopyCommand command={INSTALL_CMD} size="lg" label="最快路径——任意智能体" />
        <CopyCommand command={`${INSTALL_CMD} --list`} size="sm" label="安装前先浏览" />
      </div>
    </div>
  </div>

  <section class="container doc-section">
    <h2 class="doc-h2">按工具做原生配置</h2>
    <p class="doc-p">每种工具都有自己的一等路径。下方标签页覆盖最常用的几种。</p>

    <div class="tabs" data-tabs>
      <div class="tab-list" role="tablist" aria-label="平台">
        {platforms.map((p, i) => (
          <button
            class:list={['tab', { active: i === 0 }]}
            role="tab"
            data-tab={p.id}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {p.name}
          </button>
        ))}
      </div>

      {platforms.map((p, i) => (
        <div
          class:list={['tab-panel', { active: i === 0 }]}
          role="tabpanel"
          data-panel={p.id}
          hidden={i !== 0}
        >
          <p class="panel-intro">{p.intro}</p>
          <div class="panel-steps">
            {p.steps.map((s) => (
              <CopyCommand command={s.cmd} prompt={s.prompt} label={s.label} size="sm" />
            ))}
          </div>
          {p.note && <p class="panel-note">{p.note}</p>}
          <a href={p.docHref} target="_blank" rel="noopener" class="panel-doclink">
            完整 {p.name} 指南
            <svg viewBox="0 0 16 16" fill="none"><path d="M5 3.5h7.5V11M12.5 3.5 3.5 12.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="container doc-section">
    <h2 class="doc-h2">你的头 10 分钟</h2>
    <p class="doc-p">
      不要一次加载全部 {totalSkills} 个技能——那会浪费上下文。跟着生命周期走，合适的技能会随推进自动激活。
    </p>
    <ol class="first10">
      {first10.map((s) => (
        <li class="first10-item">
          <span class="first10-n mono">{s.n}</span>
          <div>
            <h3 class="first10-t">{s.t}</h3>
            <p class="first10-d">{s.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="container doc-section">
    <div class="next-cards">
      <a href="/docs-cn/agent-skills/tutorials/" class="card next-card">
        <h3>跑一遍实战教程 →</h3>
        <p>和你的智能体一步一步地上线一个新应用、加一个功能，或搭一条回路。</p>
      </a>
      <a href="/docs-cn/agent-skills/skills/" class="card next-card">
        <h3>浏览技能目录 →</h3>
        <p>全部 {totalSkills} 个技能，可搜索，也可按阶段过滤。</p>
      </a>
      <a href="/docs-cn/agent-skills/lifecycle/" class="card next-card">
        <h3>了解生命周期 →</h3>
        <p>八个命令如何映射到 定义 → 上线。</p>
      </a>
      <a href="/docs-cn/agent-skills/loops/" class="card next-card">
        <h3>回路工程 →</h3>
        <p>如何在回路和软件工厂里使用这些技能，以及人该守在哪一环。</p>
      </a>
      <a href="/docs-cn/agent-skills/compare/" class="card next-card">
        <h3>横向对比 →</h3>
        <p>相对 Superpowers 与 Matt Pocock 技能集的诚实定位。</p>
      </a>
    </div>
  </section>
</Base>

<style>
  .doc-hero {
    position: relative;
    padding-block: clamp(48px, 8vw, 84px) 40px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .doc-hero-inner {
    position: relative;
    max-width: 720px;
  }
  .doc-h1 {
    margin-top: 16px;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
  }
  .doc-lede {
    margin-top: 16px;
    color: var(--fg-muted);
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    line-height: 1.6;
  }
  .doc-lede a {
    color: var(--accent);
  }
  .doc-lede a:hover {
    text-decoration: underline;
  }
  .doc-hero-cmd {
    margin-top: 28px;
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .doc-section {
    padding-block: 56px;
    max-width: 860px;
  }
  .doc-h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
  }
  .doc-p {
    margin-top: 12px;
    margin-bottom: 32px;
    color: var(--fg-muted);
    max-width: 640px;
    line-height: 1.6;
  }

  /* Tabs */
  .tab-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 5px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    margin-bottom: 24px;
  }
  .tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding-inline: 15px;
    border-radius: var(--r-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--fg-muted);
    font-size: 0.9rem;
    transition: all 0.15s;
  }
  .tab:hover {
    color: var(--fg-bright);
    background: var(--surface-2);
  }
  .tab.active {
    background: var(--surface-3);
    border-color: var(--border-strong);
    color: var(--fg-bright);
  }
  .tab-panel {
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }
  .tab-panel.active {
    display: block;
  }
  .panel-intro {
    color: var(--fg);
    line-height: 1.6;
    margin-bottom: 22px;
  }
  .panel-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .panel-note {
    margin-top: 22px;
    padding: 12px 16px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-left: 2px solid var(--border-hover);
    border-radius: var(--r-sm);
    color: var(--fg-dim);
    font-size: 0.86rem;
    line-height: 1.55;
  }
  .panel-doclink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 22px;
    color: var(--fg-muted);
    font-size: 0.88rem;
  }
  .panel-doclink:hover {
    color: var(--fg-bright);
  }
  .panel-doclink svg {
    width: 13px;
    height: 13px;
  }

  /* First 10 */
  .first10 {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .first10-item {
    display: flex;
    gap: 18px;
    padding: 22px 24px;
    background: var(--bg);
  }
  .first10-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 8px;
    background: var(--surface-3);
    border: 1px solid var(--border-strong);
    color: var(--accent);
    font-size: 0.85rem;
  }
  .first10-t {
    font-size: 1.02rem;
  }
  .first10-d {
    margin-top: 6px;
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* Next cards */
  .next-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 14px;
  }
  .next-card {
    padding: 22px;
  }
  .next-card h3 {
    font-size: 1rem;
    transition: color 0.15s;
  }
  .next-card:hover h3 {
    color: var(--accent);
  }
  .next-card p {
    margin-top: 8px;
    color: var(--fg-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .next-cards {
      grid-template-columns: 1fr;
    }
    .tab-panel {
      padding: 20px;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll('.tab')) as HTMLButtonElement[];
    const panels = Array.from(root.querySelectorAll('.tab-panel')) as HTMLElement[];
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.tab;
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('active', on);
          t.setAttribute('aria-selected', String(on));
        });
        panels.forEach((p) => {
          const on = p.dataset.panel === id;
          p.classList.toggle('active', on);
          p.hidden = !on;
        });
      });
    });
  });
</script>
