---
import Base from '../layouts/Base.astro';
import CopyCommand from '../components/CopyCommand.astro';
import Lifecycle from '../components/Lifecycle.astro';
import SkillCard from '../components/SkillCard.astro';
import { featuredSkills, totalSkills, INSTALL_CMD, REPO_URL } from '../data/skills';
import { commands, personas } from '../data/agents';

const compatible = [
  'Claude Code', 'Codex', 'Cursor', 'Copilot', 'Windsurf',
  'Cline', 'Antigravity', 'OpenCode', 'Kiro',
];

const pillars = [
  {
    tag: '反合理化',
    title: '智能体没法把工作说没',
    body: '每个技能都内置一张借口对照表，列出智能体跳步时会说的原话——“回头再补测试”“这个太简单，不用写规格”——并逐条内联反驳。捷径还没被走，就已经封死。',
    icon: 'shield',
  },
  {
    tag: '验证门禁',
    title: '要证据，不要“看起来没问题”',
    body: '每个技能都以退出标准收尾：测试通过、构建产物、真实运行时数据。凭感觉不算做完。验证本身就是全部意义所在，而不是最后随手补上的点缀。',
    icon: 'check',
  },
  {
    tag: '并行评审角色',
    title: '每次上线都有评审团坐镇',
    body: '/ship 会并行展开代码评审员、安全审计员、测试工程师与 Web 性能审计员四个角色，再把他们的发现合并成一次放行/叫停（go/no-go）决定。',
    icon: 'users',
  },
  {
    tag: '仓库内 evals',
    title: '技能是被测出来的，不是被吹出来的',
    body: '三层评估套件（evals）检查结构、路由（任何两个技能不会在用户措辞上撞车）和真实执行轨迹——其中一部分跑在 CI 里。这套目录也用同样的标准要求自己。',
    icon: 'gauge',
  },
];

function iconSvg(name: string): string {
  const icons: Record<string, string> = {
    shield:
      '<svg viewBox="0 0 20 20" width="20" height="20" fill="none"><path d="M10 2.5 4 4.7v4.6c0 3.6 2.5 6 6 7.2 3.5-1.2 6-3.6 6-7.2V4.7L10 2.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="m7.5 9.8 1.8 1.8 3.2-3.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    check:
      '<svg viewBox="0 0 20 20" width="20" height="20" fill="none"><circle cx="10" cy="10" r="7.2" stroke="currentColor" stroke-width="1.3"/><path d="m6.8 10.2 2.1 2.1 4.3-4.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    users:
      '<svg viewBox="0 0 20 20" width="20" height="20" fill="none"><circle cx="7.5" cy="7" r="2.6" stroke="currentColor" stroke-width="1.3"/><path d="M3 16c0-2.5 2-4.2 4.5-4.2S12 13.5 12 16" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M13 5.2A2.4 2.4 0 0 1 14 9.9M14.5 11.9c1.8.3 3 1.7 3 3.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>',
    gauge:
      '<svg viewBox="0 0 20 20" width="20" height="20" fill="none"><path d="M3.5 14.5a7.5 7.5 0 1 1 13 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="m10 10 3.4-2.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="10" cy="10.4" r="1.1" fill="currentColor"/></svg>',
  };
  return icons[name] ?? '';
}
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="grid-bg"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <a href={REPO_URL} target="_blank" rel="noopener" class="hero-badge">
        <span class="dot"></span>
        <span>GitHub 热门趋势</span>
        <span class="hero-badge-sep">·</span>
        <span class="text-muted">{totalSkills} 个技能，MIT 许可</span>
        <svg viewBox="0 0 16 16" width="13" height="13" fill="none"><path d="M5 3.5h7.5V11M12.5 3.5 3.5 12.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <h1 class="hero-title">
        为 AI 编码智能体打造的<br />
        生产级技能。
      </h1>

      <p class="hero-sub">
        把资深工程师带进生产环境的工作流、质量门禁与判断力沉淀成技能包，让你的智能体从最初想法到线上部署，在每个阶段都始终如一地遵循它们。
      </p>

      <div class="hero-cmd">
        <CopyCommand command={INSTALL_CMD} size="lg" />
      </div>

      <div class="hero-cta">
        <a href="/docs-cn/agent-skills/docs/getting-started/" class="btn btn-primary">
          开始使用
          <svg viewBox="0 0 16 16" fill="none"><path d="M4 8h8M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/docs-cn/agent-skills/skills/" class="btn btn-secondary">浏览全部 {totalSkills} 个技能</a>
      </div>

      <div class="hero-compat">
        <span class="hero-compat-label">兼容 70+ 智能体</span>
        <div class="hero-compat-list">
          {compatible.map((c) => <span class="hero-compat-item">{c}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LIFECYCLE ============ -->
  <section class="section lifecycle-section">
    <div class="container">
      <div class="sec-head reveal">
        <span class="eyebrow"><span class="eyebrow-num">01</span> 生命周期</span>
        <h2 class="section-title">每个阶段一条命令。技能自动加载。</h2>
        <p class="section-lede">
          八条斜杠命令对应软件真实的构建方式。每条命令都会激活当下最合适的技能——设计
          API 时引入契约先行设计，构建 UI 时引入无障碍，以此类推。
        </p>
      </div>

      <div class="lifecycle-wrap reveal">
        <Lifecycle />
      </div>

      <div class="cmd-table reveal">
        {commands.map((c) => (
          <a href="/docs-cn/agent-skills/lifecycle/" class="cmd-row">
            <code class="cmd-row-cmd">{c.cmd}</code>
            <span class="cmd-row-doing">{c.doing}</span>
            <span class="cmd-row-principle">{c.principle}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- ============ SKILLS PREVIEW ============ -->
  <section class="section">
    <div class="container">
      <div class="sec-head sec-head-row reveal">
        <div>
          <span class="eyebrow"><span class="eyebrow-num">02</span> 技能目录</span>
          <h2 class="section-title">覆盖软件开发生命周期（SDLC）全流程的 {totalSkills} 个技能</h2>
          <p class="section-lede">
            不是提示词——而是带步骤、检查点和退出标准的结构化工作流。可以直接点名某个技能，也可以让元技能替你路由。
          </p>
        </div>
        <a href="/docs-cn/agent-skills/skills/" class="btn btn-secondary sec-head-cta">
          查看全部技能
          <svg viewBox="0 0 16 16" fill="none"><path d="M4 8h8M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <div class="skills-grid reveal">
        {featuredSkills.map((s) => <SkillCard skill={s} />)}
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- ============ WHY / PILLARS ============ -->
  <section class="section">
    <div class="container">
      <div class="sec-head reveal">
        <span class="eyebrow"><span class="eyebrow-num">03</span> 为什么有效</span>
        <h2 class="section-title">AI 智能体默认走最短路径。<br />这些技能把捷径封死。</h2>
        <p class="section-lede">
          放任不管，智能体会跳过规格、测试和评审——恰恰是让软件可靠的那些做法。四套机制守住底线。
        </p>
      </div>

      <div class="pillars reveal">
        {pillars.map((p) => (
          <article class="card pillar">
            <div class="pillar-icon" set:html={iconSvg(p.icon)} />
            <span class="pillar-tag mono">{p.tag}</span>
            <h3 class="pillar-title">{p.title}</h3>
            <p class="pillar-body">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- ============ PERSONAS / SHIP ============ -->
  <section class="section personas-section">
    <div class="container">
      <div class="personas-layout">
        <div class="personas-copy reveal">
          <span class="eyebrow"><span class="eyebrow-num">04</span> 专家评审</span>
          <h2 class="section-title">上线要过评审团，而不是橡皮图章</h2>
          <p class="section-lede">
            <code class="inline-cmd">/ship</code> 会执行发布前清单，并并行展开四个专家评审角色。每人带来不同的视角；他们的发现最终汇成一次诚实的放行/叫停（go/no-go）。
          </p>
          <a href="/docs-cn/agent-skills/skills/shipping-and-launch/" class="btn btn-secondary personas-cta">
            查看 /ship 流程
            <svg viewBox="0 0 16 16" fill="none"><path d="M4 8h8M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <div class="personas-grid reveal">
          {personas.map((p, i) => (
            <div class="card persona-card" style={`--i:${i}`}>
              <div class="persona-head">
                <span class="persona-avatar" aria-hidden="true">{p.role.split(' ').map((w) => w[0]).slice(0, 2).join('')}</span>
                <div>
                  <h3 class="persona-name mono">{p.name}</h3>
                  <span class="persona-role">{p.role}</span>
                </div>
              </div>
              <p class="persona-persp">{p.perspective}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- ============ FINAL CTA ============ -->
  <section class="section final-cta">
    <div class="hero-glow final-glow" aria-hidden="true"></div>
    <div class="container final-inner reveal">
      <h2 class="final-title">给你的智能体一位资深工程师的直觉。</h2>
      <p class="final-sub">一条命令即可把全部 {totalSkills} 个技能装进 70+ 智能体。</p>
      <div class="final-cmd">
        <CopyCommand command={INSTALL_CMD} size="lg" />
      </div>
      <div class="final-links">
        <a href="/docs-cn/agent-skills/docs/getting-started/" class="btn btn-primary">开始使用</a>
        <a href={REPO_URL} target="_blank" rel="noopener" class="btn btn-secondary">
          <svg viewBox="0 0 16 16" fill="currentColor" width="15" height="15"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          在 GitHub 上加星
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    padding-top: clamp(64px, 11vw, 128px);
    padding-bottom: clamp(56px, 8vw, 96px);
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    top: -180px;
    left: 50%;
    width: 900px;
    height: 560px;
    transform: translateX(-50%);
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgba(82, 168, 255, 0.14),
      transparent 70%
    );
    filter: blur(20px);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding-inline: 14px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: rgba(255, 255, 255, 0.02);
    font-size: 0.82rem;
    color: var(--fg-muted);
    transition: border-color 0.2s, background 0.2s;
  }
  .hero-badge:hover {
    border-color: var(--border-hover);
    background: var(--surface-2);
  }
  .hero-badge .dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--success);
    box-shadow: 0 0 8px var(--success);
  }
  .hero-badge-sep {
    color: var(--fg-faint);
  }
  .hero-badge svg {
    color: var(--fg-faint);
  }
  .hero-title {
    margin-top: 26px;
    font-size: clamp(2.4rem, 6.4vw, 4.4rem);
    letter-spacing: -0.04em;
    line-height: 1.02;
    background: linear-gradient(180deg, #fff 30%, #b9b9b9);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    margin-top: 22px;
    max-width: 620px;
    font-size: clamp(1.02rem, 1.9vw, 1.22rem);
    line-height: 1.55;
    color: var(--fg-muted);
  }
  .hero-cmd {
    margin-top: 34px;
    width: 100%;
    max-width: 460px;
  }
  .hero-cta {
    margin-top: 18px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero-compat {
    margin-top: 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .hero-compat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .hero-compat-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 22px;
    max-width: 720px;
  }
  .hero-compat-item {
    color: var(--fg-dim);
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .hero-compat-item:hover {
    color: var(--fg);
  }

  /* ---------- SECTION HEADS ---------- */
  .sec-head {
    max-width: 760px;
    margin-bottom: 48px;
  }
  .sec-head .section-title {
    margin-top: 18px;
  }
  .eyebrow-num {
    color: var(--fg-faint);
  }
  .sec-head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    max-width: none;
  }
  .sec-head-cta {
    flex: none;
  }

  /* ---------- LIFECYCLE ---------- */
  .lifecycle-wrap {
    margin-bottom: 48px;
    padding: 40px 24px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
  }
  .cmd-table {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .cmd-row {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    background: var(--bg);
    transition: background 0.15s;
  }
  .cmd-row:hover {
    background: var(--surface-2);
  }
  .cmd-row-cmd {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    color: var(--accent);
  }
  .cmd-row-doing {
    color: var(--fg);
    font-size: 0.9rem;
  }
  .cmd-row-principle {
    color: var(--fg-faint);
    font-size: 0.8rem;
    text-align: right;
  }

  /* ---------- SKILLS GRID ---------- */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  /* ---------- PILLARS ---------- */
  .pillars {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .pillar {
    padding: 28px;
  }
  .pillar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-md);
    background: var(--surface-3);
    border: 1px solid var(--border);
    color: var(--fg);
    margin-bottom: 20px;
  }
  .pillar-tag {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pillar-title {
    margin-top: 10px;
    font-size: 1.24rem;
    letter-spacing: -0.02em;
  }
  .pillar-body {
    margin-top: 12px;
    color: var(--fg-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  /* ---------- PERSONAS ---------- */
  .personas-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 48px;
    align-items: center;
  }
  .inline-cmd {
    font-family: var(--font-mono);
    color: var(--accent);
    background: var(--surface-2);
    padding: 1px 7px;
    border-radius: 5px;
    border: 1px solid var(--border);
    font-size: 0.9em;
  }
  .personas-cta {
    margin-top: 28px;
  }
  .personas-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .persona-card {
    padding: 20px;
  }
  .persona-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .persona-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 10px;
    background: linear-gradient(145deg, var(--surface-3), var(--surface));
    border: 1px solid var(--border-strong);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--fg-bright);
  }
  .persona-name {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--fg-bright);
  }
  .persona-role {
    font-size: 0.78rem;
    color: var(--fg-dim);
  }
  .persona-persp {
    margin-top: 14px;
    color: var(--fg-muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  /* ---------- FINAL CTA ---------- */
  .final-cta {
    position: relative;
    text-align: center;
    overflow: hidden;
  }
  .final-glow {
    top: auto;
    bottom: -260px;
    opacity: 0.8;
  }
  .final-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .final-title {
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    letter-spacing: -0.03em;
    max-width: 640px;
  }
  .final-sub {
    margin-top: 16px;
    color: var(--fg-muted);
    font-size: 1.08rem;
  }
  .final-cmd {
    margin-top: 30px;
    width: 100%;
    max-width: 460px;
  }
  .final-links {
    margin-top: 18px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .personas-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .pillars {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 860px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .cmd-table {
      grid-template-columns: 1fr;
    }
    .sec-head-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 560px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
    .cmd-row {
      grid-template-columns: 96px 1fr;
    }
    .cmd-row-principle {
      display: none;
    }
    .personas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
