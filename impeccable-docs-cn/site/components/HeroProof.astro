---
const proofs = [
  { id: 'polish', command: '/polish', label: '去除 AI 痕迹' },
  { id: 'distill', command: '/distill', label: '找出层级' },
  { id: 'clarify', command: '/clarify', label: '让任务一目了然' },
];
---

<section class="hero-proof" data-hero-proof aria-label="Impeccable 命令改前改后示例">
  <div class="hero-proof-stage">
    {proofs.map((proof, index) => (
      <div
        class:list={['hero-proof-panel', { 'is-active': index === 0 }]}
        id={`hero-proof-panel-${proof.id}`}
        role="tabpanel"
        aria-labelledby={`hero-proof-tab-${proof.id}`}
        data-proof-panel={proof.id}
        hidden={index !== 0}
      >
        <div class="hero-proof-layer hero-proof-layer--before">
          <span class="hero-proof-side-label hero-proof-side-label--before">改前</span>

          <div class={`hero-proof-canvas hero-proof-canvas--${proof.id}`} aria-hidden="true">
            {proof.id === 'polish' && (
              <article class="proof-polish proof-polish--before">
                <header class="proof-polish-head">
                  <span class="proof-polish-sprint">发布 / 14</span>
                  <span class="proof-polish-pulse">
                    <i></i> 进度正常
                  </span>
                </header>
                <div class="proof-polish-body">
                  <span class="proof-polish-kicker">
                    发布规划
                    <span class="proof-annotation">AI 眉题</span>
                  </span>
                  <div class="proof-polish-heading">
                    <h3>周五前上线<em>发布计划</em>。</h3>
                    <span class="proof-annotation">斜体衬线</span>
                  </div>
                  <p>负责人、依赖与决策，一屏尽览。</p>
                  <div class="proof-polish-progress"><i></i></div>
                  <footer><span>11 项决策已关闭 8 项</span><b>查看计划 →</b></footer>
                  <span class="proof-annotation proof-annotation--surface">AI 米色</span>
                </div>
              </article>
            )}

            {proof.id === 'distill' && (
              <article class="proof-distill proof-distill--before">
                <header>
                  <strong>数据总览</strong>
                  <span class="proof-distill-live">
                    实时
                    <span class="proof-annotation">状态徽章堆砌</span>
                  </span>
                </header>
                <div class="proof-distill-grid">
                  <div><small>营收</small><b>$84.2k</b><i>+12%</i></div>
                  <div><small>订单</small><b>1,248</b><i>+8%</i></div>
                  <div><small>访客</small><b>18.4k</b><i>+21%</i></div>
                  <div><small>转化率</small><b>3.8%</b><i>+4%</i></div>
                  <span class="proof-annotation">一切都均等</span>
                </div>
                <div class="proof-distill-nested">
                  <span>每周表现</span><div><i></i><i></i><i></i></div>
                  <span class="proof-annotation">卡中套卡</span>
                </div>
              </article>
            )}

            {proof.id === 'clarify' && (
              <article class="proof-clarify proof-clarify--before">
                <header><span>开始使用</span><small>所有字段必填</small></header>
                <div class="proof-clarify-heading">
                  <h3>今日释放你的潜力</h3>
                  <span class="proof-annotation">含糊的标题</span>
                </div>
                <div class="proof-clarify-fields">
                  <i>Acme Labs</i><i>产品负责人</i><i>激活</i><i>本季度</i>
                  <span class="proof-annotation">字段太多</span>
                </div>
                <span class="proof-clarify-cta">
                  继续
                  <span class="proof-annotation">通用 CTA</span>
                </span>
              </article>
            )}
          </div>
        </div>

        <div class="hero-proof-layer hero-proof-layer--after">
          <span class="hero-proof-side-label hero-proof-side-label--after">改后</span>

          <div class={`hero-proof-canvas hero-proof-canvas--${proof.id}`} aria-hidden="true">
            {proof.id === 'polish' && (
              <article class="proof-polish proof-polish--after">
                <header class="proof-polish-head">
                  <span class="proof-polish-sprint">发布 / 14</span>
                  <span class="proof-polish-track">进度正常</span>
                </header>
                <div class="proof-polish-body">
                  <h3>周五前上线发布计划。</h3>
                  <p>负责人、依赖与决策，一屏尽览。</p>
                  <div class="proof-polish-progress"><i></i></div>
                  <footer><span>11 项决策已关闭 8 项</span><b>查看计划 →</b></footer>
                </div>
              </article>
            )}

            {proof.id === 'distill' && (
              <article class="proof-distill proof-distill--after">
                <header><strong>营收</strong><span>近 30 天</span></header>
                <div class="proof-distill-primary"><b>$84,218</b><span>较 6 月 +12.4%</span></div>
                <div class="proof-distill-chart"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                <footer><span>订单 <b>1,248</b></span><span>转化率 <b>3.8%</b></span></footer>
              </article>
            )}

            {proof.id === 'clarify' && (
              <article class="proof-clarify proof-clarify--after">
                <header><span>新建项目</span><small>第 1 步，共 3 步</small></header>
                <h3>这个项目要改进什么？</h3>
                <p>选一个重点，之后可以再补充更多背景。</p>
                <div class="proof-clarify-options"><span>激活</span><span>留存</span><span>转化率</span></div>
                <span class="proof-clarify-cta">就用这个重点 →</span>
              </article>
            )}
          </div>
        </div>

        <div class="hero-proof-seam" aria-hidden="true"></div>
        <input
          class="hero-proof-range"
          type="range"
          min="0"
          max="100"
          value="54"
          aria-label={`查看 ${proof.command} 改进后的示例`}
          data-proof-range
        />
      </div>
    ))}
  </div>

  <div class="hero-proof-tabs" role="tablist" aria-label="预览 Impeccable 命令">
    {proofs.map((proof, index) => (
      <button
        type="button"
        role="tab"
        class:list={['hero-proof-tab', { 'is-active': index === 0 }]}
        id={`hero-proof-tab-${proof.id}`}
        aria-controls={`hero-proof-panel-${proof.id}`}
        aria-label={`${proof.command} ${proof.label}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
        data-proof-tab={proof.id}
      >
        {proof.command}
      </button>
    ))}
  </div>
</section>
