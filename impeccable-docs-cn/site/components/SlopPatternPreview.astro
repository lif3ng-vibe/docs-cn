<section
  class="slop-teaser-section slop-pattern-section"
  id="slop"
  aria-labelledby="slop-pattern-title"
  data-slop-scan
  data-detector="on"
>
  <header class="slop-pattern-head">
    <div>
      <h2 id="slop-pattern-title" class="slop-teaser-title">检测并去除 AI slop。</h2>
      <p class="slop-teaser-body">
        58 项检查在智能体顺手沿用的默认套路变成你的设计之前，把它们拦下来。
      </p>
    </div>
    <div class="slop-pattern-actions">
      <button class="slop-scan-control" type="button" aria-pressed="true" data-slop-scan-button>
        <span class="slop-scan-control-dot" aria-hidden="true"></span>
        <span data-slop-scan-label>检测器已开启</span>
      </button>
      <a class="ks-button ks-button-secondary" href="/docs-cn/impeccable/slop">
        探索全部 58 条
        <span class="ks-button-arrow" aria-hidden="true">
          <svg viewBox="0 0 16 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
            <path d="M0 4h14M10 0l4 4-4 4"/>
          </svg>
        </span>
      </a>
    </div>
  </header>

  <div class="slop-pattern-board" aria-label="检测出的 AI 设计模式交互画廊">
    <a
      class="slop-pattern-item slop-pattern-item--serif"
      href="/docs-cn/impeccable/slop#rule-italic-serif-display""
      aria-label="查看规则：AI 米色底上的斜体衬线大标题"
      style="--scan-order: 0"
    >
      <span class="slop-pattern-specimen slop-pattern-specimen--serif" aria-hidden="true">
        <span class="slop-target slop-target--serif" data-label="AI 米色 + 衬线">
          精心 <em>打造</em><br />面向现代团队。
        </span>
      </span>
    </a>

    <a
      class="slop-pattern-item slop-pattern-item--soft-card"
      href="/docs-cn/impeccable/slop#rule-generic-drop-shadows""
      aria-label="查看规则：圆角矩形配通用投影"
      style="--scan-order: 1"
    >
      <span class="slop-pattern-specimen slop-pattern-specimen--soft-card" aria-hidden="true">
        <span class="slop-target slop-target--soft-card" data-label="软圆角卡片">
          <span class="slop-soft-card-icon">✦</span>
          <strong>一切尽在一处</strong>
          <span class="slop-soft-card-copy">轻松规划、创建、协作。</span>
          <span class="slop-soft-card-action">开始使用 <i>→</i></span>
        </span>
      </span>
    </a>

    <a
      class="slop-pattern-item slop-pattern-item--sidetab"
      href="/docs-cn/impeccable/slop#rule-side-tab""
      aria-label="查看规则：侧边彩条边框"
      style="--scan-order: 2"
    >
      <span class="slop-pattern-specimen slop-pattern-specimen--sidetab" aria-hidden="true">
        <span class="slop-target slop-target--sidetab" data-label="侧边彩条边框">
          <strong>性能洞察</strong>
          <span>你的转化率本周上涨 12%。</span>
        </span>
      </span>
    </a>

    <a
      class="slop-pattern-item slop-pattern-item--eyebrow"
      href="/docs-cn/impeccable/slop#rule-hero-eyebrow-chip""
      aria-label="查看规则：主标题上方的徽章"
      style="--scan-order: 3"
    >
      <span class="slop-pattern-specimen slop-pattern-specimen--eyebrow" aria-hidden="true">
        <span class="slop-target slop-target--eyebrow" data-label="眉题芯片">
          <span class="slop-eyebrow-chip">全新推出</span>
          <strong>现代团队的<br />操作系统。</strong>
          <span>更快前进所需的一切。</span>
        </span>
      </span>
    </a>

    <a
      class="slop-pattern-item slop-pattern-item--pulse"
      href="/docs-cn/impeccable/slop#section-motion""
      aria-label="查看规则：脉动状态点"
      style="--scan-order: 4"
    >
      <span class="slop-pattern-specimen slop-pattern-specimen--pulse" aria-hidden="true">
        <span class="slop-target slop-target--pulse" data-label="脉冲状态点">
          <span class="slop-pulse-status"><i class="slop-pulse-dot"></i> AI 正在思考</span>
          <span class="slop-pulse-lines"><i></i><i></i><i></i></span>
        </span>
      </span>
    </a>

    <a
      class="slop-pattern-item slop-pattern-item--nested"
      href="/docs-cn/impeccable/slop#rule-nested-cards""
      aria-label="查看规则：嵌套卡片"
      style="--scan-order: 5"
    >
      <span class="slop-pattern-specimen slop-pattern-specimen--nested" aria-hidden="true">
        <span class="slop-target slop-target--nested" data-label="卡片套卡片">
          <span>工作区</span>
          <span class="slop-nested-card">
            <span>概览</span>
            <span class="slop-nested-card slop-nested-card--inner">卡里套卡再套卡。</span>
          </span>
        </span>
      </span>
    </a>

    <a
      class="slop-pattern-item slop-pattern-item--icons"
      href="/docs-cn/impeccable/slop#rule-icon-tile-stack""
      aria-label="查看规则：图标块堆叠在标题上方"
      style="--scan-order: 6"
    >
      <span class="slop-pattern-specimen slop-pattern-specimen--icons" aria-hidden="true">
        <span class="slop-target slop-target--icons" data-label="同款图标卡阵列">
          <span><i>✦</i><b>自动化</b><small>更快前进。</small></span>
          <span><i>⌁</i><b>集成</b><small>更聪明地工作。</small></span>
          <span><i>↗</i><b>扩展</b><small>一起成长。</small></span>
        </span>
      </span>
    </a>

    <a
      class="slop-pattern-item slop-pattern-item--markers"
      href="/docs-cn/impeccable/slop#rule-numbered-section-labels""
      aria-label="查看规则：迷你编号区块标签"
      style="--scan-order: 7"
    >
      <span class="slop-pattern-specimen slop-pattern-specimen--markers" aria-hidden="true">
        <span class="slop-target slop-target--markers" data-label="编号小节标签">
          <span><b>01</b> 探索</span>
          <span><b>02</b> 设计</span>
          <span><b>03</b> 交付</span>
        </span>
      </span>
    </a>
  </div>
</section>

<script>
  const setupSlopDetectors = () => {
    document.querySelectorAll<HTMLElement>('[data-slop-scan]').forEach((root) => {
      if (root.dataset.scanReady === 'true') return;
      root.dataset.scanReady = 'true';

      const button = root.querySelector<HTMLButtonElement>('[data-slop-scan-button]');
      const label = root.querySelector<HTMLElement>('[data-slop-scan-label]');
      if (!button || !label) return;

      const setDetector = (active: boolean) => {
        root.dataset.detector = active ? 'on' : 'off';
        button.setAttribute('aria-pressed', String(active));
        label.textContent = active ? '检测器已开启' : '检测器已关闭';
      };

      button.addEventListener('click', () => {
        setDetector(button.getAttribute('aria-pressed') !== 'true');
      });
    });
  };

  setupSlopDetectors();
  document.addEventListener('astro:page-load', setupSlopDetectors);
</script>
