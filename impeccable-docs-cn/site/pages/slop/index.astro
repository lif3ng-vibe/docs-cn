---
import Base from '../../layouts/Base.astro';
import SlopRuleCard from '../../components/SlopRuleCard.astro';
import '../../styles/sub-pages.css';
import '../../styles/slop-kinpaku.css';
import { ANTIPATTERNS } from '../../../cli/engine/registry/antipatterns.mjs';

const CRITIQUE_ONLY_COUNT = 5;
const DETECTOR_RULE_COUNT = ANTIPATTERNS.length;
const TOTAL_PATTERN_COUNT = DETECTOR_RULE_COUNT + CRITIQUE_ONLY_COUNT;
const CATALOG_RULE_IDS = {
  designSystem: ['design-system-font', 'design-system-color', 'design-system-radius', 'design-system-font-size'],
  visualDetails: ['codex-grid-background'],
  colorContrast: ['radial-halo'],
  layoutSpace: ['numbered-section-labels', 'edge-flush-cards', 'text-occlusion', 'first-viewport-column-overflow', 'heading-rhythm'],
  motion: ['pulsing-dot', 'blinking-cursor', 'marquee'],
  copy: ['repeated-container-text'],
  imagery: ['shape-assembled-illustration'],
  generalQuality: ['script-error', 'content-hidden-at-rest'],
};

const CATALOG_RULE_LAYERS = {
  'blinking-cursor': 'browser',
  'script-error': 'browser',
  'content-hidden-at-rest': 'browser',
  'edge-flush-cards': 'browser',
  'text-occlusion': 'browser',
  'first-viewport-column-overflow': 'browser',
  'heading-rhythm': 'browser',
};

const CATALOG_RULE_VISUALS = {
  'pulsing-dot': `<div class="catalog-rule-demo catalog-rule-demo--center"><span style="width:12px;height:12px;border-radius:50%;background:#20a37a;box-shadow:0 0 0 7px rgba(32,163,122,.14),0 0 0 14px rgba(32,163,122,.06)"></span><span style="font:600 12px system-ui;color:#222">系统运行正常</span></div>`,
  'blinking-cursor': `<div class="catalog-rule-demo catalog-rule-demo--terminal"><span>&gt; 构建未来</span><b style="display:inline-block;width:8px;height:18px;background:#d4a72c;margin-left:4px"></b></div>`,
  'shape-assembled-illustration': `<div class="catalog-rule-demo catalog-rule-demo--center"><svg width="150" height="86" viewBox="0 0 150 86" fill="none"><rect x="20" y="38" width="52" height="34" rx="8" fill="#eadfce"/><circle cx="46" cy="32" r="19" fill="#d4a72c"/><path d="M77 71c8-28 23-42 46-42v42H77Z" fill="#5c9b8f"/><circle cx="113" cy="20" r="8" fill="#222"/></svg></div>`,
  'radial-halo': `<div class="catalog-rule-demo" style="background:radial-gradient(circle at 50% 45%,rgba(130,92,246,.62),rgba(130,92,246,0) 58%),#101014;color:#fff;display:grid;place-items:center;font:600 16px system-ui">环境光晕</div>`,
  'marquee': `<div class="catalog-rule-demo catalog-rule-demo--marquee"><span>NORTHWIND&nbsp;&nbsp; HALCYON&nbsp;&nbsp; MERIDIAN&nbsp;&nbsp; FIELDNOTE&nbsp;&nbsp; NORTHWIND</span></div>`,
  'numbered-section-labels': `<div class="catalog-rule-demo catalog-rule-demo--numbers"><span><i>01</i>探索</span><span><i>02</i>设计</span><span><i>03</i>交付</span></div>`,
  'script-error': `<div class="catalog-rule-demo catalog-rule-demo--console"><span>Uncaught TypeError</span><small>Cannot read properties of null</small><code>app.js:42:17</code></div>`,
  'content-hidden-at-rest': `<div class="catalog-rule-demo catalog-rule-demo--hidden"><strong>可见的标题</strong><span>这个页面的大部分从未离开 opacity: 0。</span><span>显示回调没有执行。</span></div>`,
  'edge-flush-cards': `<div class="catalog-rule-demo catalog-rule-demo--scroller"><span></span><span></span><span></span></div>`,
  'text-occlusion': `<div class="catalog-rule-demo catalog-rule-demo--occlusion"><strong>文字应当保持可读。</strong><span></span></div>`,
  'first-viewport-column-overflow': `<div class="catalog-rule-demo catalog-rule-demo--columns"><span></span><span></span></div>`,
  'heading-rhythm': `<div class="catalog-rule-demo catalog-rule-demo--rhythm"><p></p><h4>新区块</h4><span></span><span></span></div>`,
  'repeated-container-text': `<div class="catalog-rule-demo catalog-rule-demo--repeat"><strong>就绪</strong><span>就绪</span><button>就绪</button></div>`,
  'design-system-font': `<div class="catalog-rule-demo catalog-rule-demo--token"><span>字体排印</span><strong style="font-family:Georgia,serif">Aa</strong><code>Comic Sans MS</code><i>不在 DESIGN.md 中</i></div>`,
  'design-system-color': `<div class="catalog-rule-demo catalog-rule-demo--swatches"><span style="background:#d4a72c"></span><span style="background:#5c9b8f"></span><span class="is-outlier" style="background:#b026ff"></span></div>`,
  'design-system-radius': `<div class="catalog-rule-demo catalog-rule-demo--radius"><span style="border-radius:4px">4</span><span style="border-radius:8px">8</span><span class="is-outlier" style="border-radius:28px">28</span></div>`,
  'design-system-font-size': `<div class="catalog-rule-demo catalog-rule-demo--scale"><span>14</span><span>16</span><span>24</span><b>19</b></div>`,
  'codex-grid-background': `<div class="catalog-rule-demo" style="background-image:linear-gradient(rgba(70,80,90,.16) 1px,transparent 1px),linear-gradient(90deg,rgba(70,80,90,.16) 1px,transparent 1px);background-size:18px 18px;display:grid;place-items:center"><span style="background:#fff;border:1px solid #ddd;padding:9px 14px;font:600 12px system-ui;color:#222">装饰性网格</span></div>`,
};

const CATALOG_RULE_COPY = {
  'pulsing-dot': '脉动的状态点在毫无变化时也在吸引注意。静态状态请保持静止，动效留给真正重要的活动信号。',
  'blinking-cursor': '闪烁光标让普通文字看起来可编辑或像终端。静态文案请移除；人们可以输入的地方才保留。',
  'shape-assembled-illustration': '用通用圆形和色块拼出的场景，看起来就像占位图。请选择能传达产品具体信息的图像。',
  'radial-halo': '暗色页面上的明亮光晕是常见的 AI 背景效果。当它与内容抢眼、或在设计中毫无作用时，请移除。',
  'marquee': '自动滚动的文字或 Logo 逼人按页面的节奏阅读。请让它们静止，或提供暂停和浏览的控制。',
  'numbered-section-labels': '标题旁的迷你编号在没有顺序可循时只会添乱。编号请留给真正有先后之分的步骤或次序。',
  'script-error': '未捕获的 JavaScript 错误可能让控件失灵或内容消失。请先修好错误、确认页面能用，再打磨外观。',
  'content-hidden-at-rest': '入场动画没能执行时，内容就一直藏着。请让内容默认可见，这样动画失败时页面照样能用。',
  'edge-flush-cards': '卡片直接顶到滚动容器边缘，周围没有空间。请在两端加上对称的留白，让首末卡片有清晰的边界。',
  'text-occlusion': '不透明的层盖住了可读文字。请移开该层，或给文字留出清晰的空间。',
  'first-viewport-column-overflow': '开篇的某一栏比另一栏长出一大截，留下大片空白。请重新平衡内容，或把较长的部分移到两栏之下。',
  'heading-rhythm': '标题与上方内容的距离比与自己内容的距离更近。请让标题上方的间距大于下方。',
  'repeated-container-text': '同一个标签出现在一张卡片的多个位置。请只保留一处，放在最重要的地方。',
  'design-system-font': '该字体不在你既定的字体体系中。请使用已批准的字体；若是有意新增，请更新 DESIGN.md。',
  'design-system-color': '该颜色不在你既定的色板中。请使用色板中的颜色，或把新颜色加入你的设计系统。',
  'design-system-radius': '该圆角值不在你既定的刻度中。请使用现有的圆角，或更新体系以纳入新的形状。',
  'design-system-font-size': '该字号不在你既定的字号刻度中。请使用现有字号，或向体系加入新的档位。',
  'codex-grid-background': '装饰性网格只添加线条，无助于使用页面。网格请留给画布、地图或需要度量的任务。',
};

const catalogRules = Object.fromEntries(
  Object.entries(CATALOG_RULE_IDS).map(([section, ids]) => [
    section,
    ids.map((id) => ANTIPATTERNS.find((rule) => rule.id === id)).filter(Boolean),
  ]),
);
---

<Base
  title="Slop 图鉴 | Impeccable（汉化版）"
  description={`${TOTAL_PATTERN_COUNT} 种会让界面显得由 AI 生成或粗制滥造的模式，涵盖全部 ${DETECTOR_RULE_COUNT} 条确定性检测规则。`}
  activeNav="slop"
  canonicalPath="/slop"
  bodyClass="sub-page skills-layout-page slop-page slop-kinpaku kinpaku-chrome"
>

<div class="skills-layout">
  
<aside class="skills-sidebar slop-sidebar" aria-label="Slop 页分区">
  <button class="skills-sidebar-toggle" type="button" aria-expanded="false" aria-controls="slop-sidebar-inner">
    <span class="skills-sidebar-toggle-label">本页内容</span>
    <svg class="skills-sidebar-toggle-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
  </button>
  <div class="skills-sidebar-inner" id="slop-sidebar-inner">
    <p class="skills-sidebar-label">本页内容</p>
    <div class="skills-sidebar-group">
      <ul class="skills-sidebar-list anti-patterns-sidebar-list">
        <li><a href="#see-it"><span>历年 Slop 演变</span></a></li>
        <li><a href="#try-it-live"><span>上手试</span><span class="anti-patterns-sidebar-count">11</span></a></li>
        <li>
          <a href="#catalog"><span>规则目录</span><span class="anti-patterns-sidebar-count">{TOTAL_PATTERN_COUNT}</span></a>
          <ul class="slop-sidebar-sublist">
            <li><a href="#section-design-system"><span>你的设计系统</span><span class="anti-patterns-sidebar-count">4</span></a></li>
            <li><a href="#section-visual-details"><span>视觉细节</span><span class="anti-patterns-sidebar-count">8</span></a></li>
            <li><a href="#section-typography"><span>字体排印</span><span class="anti-patterns-sidebar-count">10</span></a></li>
            <li><a href="#section-color-contrast"><span>色彩与对比</span><span class="anti-patterns-sidebar-count">6</span></a></li>
            <li><a href="#section-layout-space"><span>布局与空间</span><span class="anti-patterns-sidebar-count">13</span></a></li>
            <li><a href="#section-motion"><span>动效</span><span class="anti-patterns-sidebar-count">6</span></a></li>
            <li><a href="#section-copy"><span>文案</span><span class="anti-patterns-sidebar-count">5</span></a></li>
            <li><a href="#section-imagery"><span>图像</span><span class="anti-patterns-sidebar-count">2</span></a></li>
            <li><a href="#section-general-quality"><span>通用品质</span><span class="anti-patterns-sidebar-count">10</span></a></li>
          </ul>
        </li>
        <li><a href="#run-it"><span>自己跑</span></a></li>
      </ul>
    </div>
  </div>
</aside>
  <div class="skills-main">

<div class="anti-patterns-content slop-content">
  <header class="anti-patterns-header slop-header">
    <h1 class="sub-page-title">Slop</h1>
    <p class="sub-page-lede">{TOTAL_PATTERN_COUNT} 种暴露 AI 默认套路与上线缺陷的模式。可以查看覆盖层演示、在 11 个合成样例上试用，或浏览规则目录。检测器现已覆盖源码与渲染页面的 {DETECTOR_RULE_COUNT} 条规则，全部默认启用。另有五项更综合的判断保留在 <a href="/docs-cn/impeccable/docs/critique">/impeccable critique</a> 中。</p>
  </header>

  <section class="slop-section slop-then-now" id="see-it" aria-label="检测覆盖层演示">
    <h2 class="slop-section-heading">历年 Slop 演变</h2>
    <div class="slop-then-now-intro">
    <p class="slop-then-now-lede">每一波 AI 生成界面都会收敛出一种一眼可辨的美学。检测器对哪一波都照抓不误。变的只是套路。</p>
    <div class="slop-era-toggle slop-era-toggle--ink" role="tablist" aria-label="对比不同年代与模型习惯">
      <button class="slop-era-tab is-active" role="tab" aria-selected="true" data-era="2022">2022</button>
      <button class="slop-era-tab" role="tab" aria-selected="false" data-era="2026">2026</button>
    </div>
    </div>
    <div class="visual-mode-preview">
      <div class="visual-mode-preview-header">
        <span class="visual-mode-preview-dot red"></span>
        <span class="visual-mode-preview-dot yellow"></span>
        <span class="visual-mode-preview-dot green"></span>
        <span class="visual-mode-preview-title" data-title-2022="紫色渐变、玻璃面板、霓虹光晕" data-title-2026="AI 米色、杂志风脚手架、装饰性动效">紫色渐变、玻璃面板、霓虹光晕</span>
      </div>
      <iframe src="/docs-cn/impeccable/antipattern-examples/old-slop-2022.html" class="visual-mode-frame slop-era-frame" data-era="2022" loading="lazy" title="2022 年代 AI slop 上的 Impeccable 覆盖层"></iframe>
      <iframe src="/docs-cn/impeccable/antipattern-examples/new-slop-2026.html" class="visual-mode-frame slop-era-frame" data-era="2026" loading="lazy" title="2026 年代 AI slop 上的 Impeccable 覆盖层" style="display:none"></iframe>
    </div>
    <p class="visual-mode-demo-caption">悬停或点按任意带轮廓的元素，查看触发了哪条规则。切换年代标签，看看这些套路如何变迁。</p>
  </section>

  <section class="slop-section visual-mode-gallery" id="try-it-live" aria-label="在合成样例上试用覆盖层">
    <header class="visual-mode-gallery-header">
      <h2 class="slop-section-heading">上手试</h2>
      <p class="visual-mode-gallery-lede">这 11 个合成 Slop 页面出厂即内置检测器脚本。点开任意一个，看看覆盖层在真实页面上如何运行，再悬停那些带轮廓的元素。</p>
    </header>
    <div class="gallery-grid">

      <a class="gallery-card" href="/docs-cn/impeccable/antipattern-examples/purple-gradients.html">
        <div class="gallery-card-thumb">
          <img src="/docs-cn/impeccable/antipattern-images/purple-gradients.png" alt="到处都是紫色渐变 样例" loading="lazy" width="540" height="540">
        </div>
        <div class="gallery-card-body">
          <h3 class="gallery-card-title">到处都是紫色渐变</h3>
          <p class="gallery-card-desc">AI 式配色：紫到蓝的渐变铺满一切——按钮、文字、背景、光球。新版“让它更抢眼”。</p>
        </div>
      </a>

      <a class="gallery-card" href="/docs-cn/impeccable/antipattern-examples/lazy-cool.html">
        <div class="gallery-card-thumb">
          <img src="/docs-cn/impeccable/antipattern-images/lazy-cool.png" alt="偷懒的“酷” 样例" loading="lazy" width="540" height="540">
        </div>
        <div class="gallery-card-body">
          <h3 class="gallery-card-title">偷懒的“酷”</h3>
          <p class="gallery-card-desc">玻璃拟态、霓虹光晕、虚化光球、满眼等宽字体。像黑客松作品，不像产品。</p>
        </div>
      </a>

      <a class="gallery-card" href="/docs-cn/impeccable/antipattern-examples/lazy-impact.html">
        <div class="gallery-card-thumb">
          <img src="/docs-cn/impeccable/antipattern-images/lazy-impact.png" alt="偷懒的“冲击力” 样例" loading="lazy" width="540" height="540">
        </div>
        <div class="gallery-card-body">
          <h3 class="gallery-card-title">偷懒的“冲击力”</h3>
          <p class="gallery-card-desc">拿不准就让一切都动起来。弹跳的按钮、扭动的图标、渐变文字、漂浮的徽章。没有意义的动效。</p>
        </div>
      </a>

      <a class="gallery-card" href="/docs-cn/impeccable/antipattern-examples/thick-border-cards.html">
        <div class="gallery-card-thumb">
          <img src="/docs-cn/impeccable/antipattern-images/thick-border-cards.png" alt="侧边彩条卡片 样例" loading="lazy" width="540" height="540">
        </div>
        <div class="gallery-card-body">
          <h3 class="gallery-card-title">侧边彩条卡片</h3>
          <p class="gallery-card-desc">圆角卡片一侧的粗彩边。AI 生成界面最容易被认出的破绽，没有之一。</p>
        </div>
      </a>

      <a class="gallery-card" href="/docs-cn/impeccable/antipattern-examples/cardocalypse.html">
        <div class="gallery-card-thumb">
          <img src="/docs-cn/impeccable/antipattern-images/cardocalypse.png" alt="卡片末日 样例" loading="lazy" width="540" height="540">
        </div>
        <div class="gallery-card-body">
          <h3 class="gallery-card-title">卡片末日</h3>
          <p class="gallery-card-desc">卡片套卡片套卡片。五层嵌套，每层都有自己的内边距和阴影。</p>
        </div>
      </a>

      <a class="gallery-card" href="/docs-cn/impeccable/antipattern-examples/layout-templates.html">
        <div class="gallery-card-thumb">
          <img src="/docs-cn/impeccable/antipattern-images/layout-templates.png" alt="复制粘贴式版式 样例" loading="lazy" width="540" height="540">
        </div>
        <div class="gallery-card-body">
          <h3 class="gallery-card-title">复制粘贴式版式</h3>
          <p class="gallery-card-desc">同一套“首屏-指标-功能”模板换个配色反复出现。每个分区都长得一样时，就什么都不突出了。</p>
        </div>
      </a>

      <a class="gallery-card" href="/docs-cn/impeccable/antipattern-examples/inter-everywhere.html">
        <div class="gallery-card-thumb">
          <img src="/docs-cn/impeccable/antipattern-images/inter-everywhere.png" alt="Inter 铺天盖地 样例" loading="lazy" width="540" height="540">
        </div>
        <div class="gallery-card-body">
          <h3 class="gallery-card-title">Inter 铺天盖地</h3>
          <p class="gallery-card-desc">一款字体包打天下。标题、正文、标签、按钮全是它。没有字体排印层级，没有个性，也没有设计。</p>
        </div>
      </a>

      <a class="gallery-card" href="/docs-cn/impeccable/antipattern-examples/massive-icons.html">
        <div class="gallery-card-thumb">
          <img src="/docs-cn/impeccable/antipattern-images/massive-icons.png" alt="巨型图标 样例" loading="lazy" width="540" height="540">
        </div>
        <div class="gallery-card-body">
          <h3 class="gallery-card-title">巨型图标</h3>
          <p class="gallery-card-desc">图标容器比它所介绍的内容还大。装饰大过信息时，优先级就反了。</p>
        </div>
      </a>

      <a class="gallery-card" href="/docs-cn/impeccable/antipattern-examples/bad-contrast.html">
        <div class="gallery-card-thumb">
          <img src="/docs-cn/impeccable/antipattern-images/bad-contrast.png" alt="糟糕的对比度选择 样例" loading="lazy" width="540" height="540">
        </div>
        <div class="gallery-card-body">
          <h3 class="gallery-card-title">糟糕的对比度选择</h3>
          <p class="gallery-card-desc">彩色背景上的灰色文字、低对比度标签、没法读的组合。好看和可读本不该互相冲突。</p>
        </div>
      </a>

      <a class="gallery-card" href="/docs-cn/impeccable/antipattern-examples/redundant-ux-writing.html">
        <div class="gallery-card-thumb">
          <img src="/docs-cn/impeccable/antipattern-images/redundant-ux-writing.png" alt="冗余的 UX 文案 样例" loading="lazy" width="540" height="540">
        </div>
        <div class="gallery-card-body">
          <h3 class="gallery-card-title">冗余的 UX 文案</h3>
          <p class="gallery-card-desc">标签、子标签、辅助文字、提示文字，用略有差异的措辞说同一件事。只说一次，把它说好。</p>
        </div>
      </a>

      <a class="gallery-card" href="/docs-cn/impeccable/antipattern-examples/modal-abuse.html">
        <div class="gallery-card-thumb">
          <img src="/docs-cn/impeccable/antipattern-images/modal-abuse.png" alt="弹窗滥用 样例" loading="lazy" width="540" height="540">
        </div>
        <div class="gallery-card-body">
          <h3 class="gallery-card-title">弹窗滥用</h3>
          <p class="gallery-card-desc">复杂设置塞进一个弹窗。既然需要滚动条和三栏布局，它就该拥有自己的页面。</p>
        </div>
      </a>
    </div>
  </section>

  <section class="slop-section slop-catalog" id="catalog" aria-label="规则目录">
    <header class="slop-catalog-header">
      <h2 class="slop-section-heading">规则目录</h2>
