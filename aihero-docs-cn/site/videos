he request payload\n\nConfirm you can see exactly what was sent to the LLM provider.\n\n- [ ] Examine the streaming response\n\nUnderstand how the response was streamed back from the provider.\n","matchLevel":"none","matchedWords":[]},"free":{"value":"true","matchLevel":"none","matchedWords":[]},"has_video":{"value":"true","matchLevel":"none","matchedWords":[]},"id":{"value":"lesson-xctv5","matchLevel":"none","matchedWords":[]},"mux_playback_id":{"value":"ZdjkTEiFKCOE00wzYXuZjk6Fqeo59hqN9WBd5mW02IXgk","matchLevel":"none","matchedWords":[]},"parentResources":[{"id":{"value":"workshop-xoh13","matchLevel":"none","matchedWords":[]},"slug":{"value":"ai-sdk-v5-crash-course","matchLevel":"none","matchedWords":[]},"state":{"value":"published","matchLevel":"none","matchedWords":[]},"title":{"value":"AI SDK v5 Crash Course","matchLevel":"none","matchedWords":[]},"type":{"value":"workshop","matchLevel":"none","matchedWords":[]},"visibility":{"value":"public","matchLevel":"none","matchedWords":[]}}],"slug":{"value":"devtools-basics-xctv5","matchLevel":"none","matchedWords":[]},"state":{"value":"published","matchLevel":"none","matchedWords":[]},"summary":{"value":"Master Devtools basics to enhance web development efficiency. Discover essential tools and tips for debugging, inspecting, and optimizing your code.","matchLevel":"none","matchedWords":[]},"thumbnail_time":{"value":"160","matchLevel":"none","matchedWords":[]},"title":{"value":"Devtools Basics","matchLevel":"none","matchedWords":[]},"type":{"value":"lesson","matchLevel":"none","matchedWords":[]},"updated_at_timestamp":{"value":"1769531797877","matchLevel":"none","matchedWords":[]},"video_resource_id":{"value":"explainer-5drBX21cB.mp4","matchLevel":"none","matchedWords":[]},"visibility":{"value":"unlisted","matchLevel":"none","matchedWords":[]},"workshop_slug":{"value":"ai-sdk-v6-crash-course","matchLevel":"none","matchedWords":[]}},"_highlightResult":{"container_title":{"value":"AI SDK v6 Crash Course","matchLevel":"non