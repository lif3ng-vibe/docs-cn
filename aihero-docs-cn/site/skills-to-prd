,\"/_next/static/immutable/chunks/0aokmjsosywzz.js\",\"/_next/static/immutable/chunks/2rl5p0ki12_dh.js\",\"/_next/static/immutable/chunks/38brh3gl87z66.js\",\"/_next/static/immutable/chunks/3x9203tghlygm.js\",\"/_next/static/immutable/chunks/197ng827wkq0e.js\",\"/_next/static/immutable/chunks/14-8dr-5dlan4.js\",\"/_next/static/immutable/chunks/1zdwa904tw6f8.js\",\"/_next/static/immutable/chunks/1avq070q3l5wj.js\",\"/_next/static/immutable/chunks/0dtawoxgtq5li.js\",\"/_next/static/immutable/chunks/1a0ilsq3vsaps.js\"],\"default\"]\n4e:[\"$\",\"p\",null,{\"className\":\"text-base leading-[1.3] tracking-[-0.018em] group-hover:text-foreground truncate font-medium text-[color:var(--ah-fg-muted)] transition-colors\",\"children\":[\"$\",\"span\",null,{\"className\":\"flex min-w-0 items-center gap-1.5\",\"children\":[null,[\"$\",\"span\",null,{\"className\":\"font-mono text-xs font-medium truncate min-[901px]:hidden\",\"children\":[\"/\",\"to-tickets\"]}],[\"$\",\"span\",null,{\"className\":\"hidden truncate min-[901px]:inline\",\"children\":\"The /to-tickets Skill\"}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"ml-auto size-4 shrink-0\",\"aria-hidden\":true,\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}],\"$undefined\"]}]]}]}]\n4f:[\"$\",\"span\",null,{\"aria-hidden\":true,\"className\":\"size-[7px] flex-none rounded-full transition-colors bg-foreground/20\"}]\n50:[\"$\",\"span\",null,{\"className\":\"font-mono text-xs font-medium whitespace-nowrap transition-colors text-[color:var(--ah-fg-label)] group-hover:text-foreground\",\"children\":\"Reference Skills\"}]\n56:[\"$\",\"code\",null,{\"children\":\".scratch/\",\"className\":\"ah-code-inline\"}]\n57:[\"$\",\"$L52\",null,{\"level\":2,\"children\":\"The spec is a decision record\"}]\n58:[\"$\",\"p\",null,{\"children\":[\"The spec exists because context windows end. You settled many things while \",[\"$\",\"$L53\",null,{\"href\":\"/ai-coding-dictionary/grilling\",\"dictionaryTitle\":\"Grilling\",\"dictionaryDescription\":\"A technique for developing a design concept: the agent interviews the user Socratically, one decision at a time.\",\"children\":\"grilling\"}],\": the shape of the solution, the choices you argued through, and what you deliberately refused. All of that is in one conversation that you are about to clear. The spec keeps it.\"],\"className\":\"ah-prose-p\"}]\n59:[\"$\",\"p\",null,{\"children\":\"So the spec does not validate or decide anything. It records what you decided, in your project's own vocabulary, so a fresh session can pick up the work without you explaining it again. If the spec states something you never said, that is a defect.\",\"className\":\"ah-prose-p\"}]\n5a:[\"$\",\"$L52\",null,{\"level\":2,\"children\":\"Seams before prose\"}]\n5b:[\"$\",\"p\",null,{\"children\":[\"Before it writes anything, \",[\"$\",\"code\",null,{\"children\":\"to-spec\",\"className\":\"ah-code-inline\"}],\" sketches the \",[\"$\",\"strong\",null,{\"children\":\"seams\",\"className\":\"ah-prose-strong\"}],\" where the feature will be tested, and checks them with you. It prefers existing seams to new ones, and picks the highest seam it can. The ideal number of seams for a change is one.\"],\"className\":\"ah-prose-p\"}]\n5c:[\"$\",\"p\",null,{\"children\":[\"Other skills use those agreed seams later. \",[\"$\",\"$L6\",null,{\"href\":\"/skills-tdd\",\"title\":\"$undefined\",\"className\":\"ah-prose-a\",\"children\":\"tdd\"}],\" works only at seams you agreed in advance. \",[\"$\",\"$L6\",null,{\"href\":\"/skills-code-review\",\"title\":\"$undefined\",\"className\":\"ah-prose-a\",\"children\":\"code-review\"}],\" reviews the diff against the spec, so a seam nobody agreed to shows up as a review finding. Both connections go through this document. That is why you should take the seam conversation seriously here, and not leave it for implementation.\"],\"className\":\"ah-prose-p\"}]\n5d:[\"$\",\"$L52\",null,{\"level\":2,\"children\":\"Common questions\"}]\n5e:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Where did \",[\"$\",\"code\",null,{\"children\":\"/to-prd\",\"className\":\"ah-code-inline\"}],\" go?\"],\"className\":\"ah-prose-strong\"}],\"\\nIt is this skill, renamed in v1.1. \\\"Spec\\\" is now the one term used throughout, and the old \",[\"$\",\"code\",null,{\"children\":\"to-prd\",\"className\":\"ah-code-inline\"}],\" slug no longer works, so reinstall under the new name. The old vocabulary is replaced by the pair \",[\"$\",\"em\",null,{\"children\":\"spec\",\"className\":\"ah-prose-em\"}],\" and \",[\"$\",\"em\",null,{\"children\":\"tickets\",\"className\":\"ah-prose-em\"}],\". The spec is the destination and the decisions that fix it. The \",[\"$\",\"$L53\",null,{\"href\":\"/ai-coding-dictionary/ticket\",\"dictionaryTitle\":\"Ticket\",\"dictionaryDescription\":\"A handoff artifact scoping one session of work. Stands alone or hangs off a spec. Can block or be blocked by sibling tickets.\",\"children\":\"tickets\"}],\" are the steps that get there. If you change direction, delete the unfinished tickets and keep the spec.\"],\"className\":\"ah-prose-p\"}]\n5f:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Why does the spec get the \",[\"$\",\"code\",null,{\"children\":\"ready-for-agent\",\"className\":\"ah-code-inline\"}],\" label? I don't want an agent implementing off it.\"],\"className\":\"ah-prose-strong\"}],\"\\nThe label means \\\"no further triage needed\\\": the document is complete enough for an agent to work from. It marks an input, not a work order. But \",[\"$\",\"$L53\",null,{\"href\":\"/ai-coding-dictionary/afk\",\"dictionaryTitle\":\"AFK\",\"dictionaryDescription\":\"A working pattern where the user kicks off a session and leaves the agent to run unattended (away from keyboard).\",\"children\":\"AFK\"}],\" agents that poll for \",[\"$\",\"code\",null,{\"children\":\"ready-for-agent\",\"className\":\"ah-code-inline\"}],\" cannot see that difference. They will try to build the whole spec in one run instead of picking up the ticket slices. This is the most-reported problem with the skill. Until it changes, exclude the parent spec explicitly in your AFK agent's prompt, or remove the label after \",[\"$\",\"code\",null,{\"children\":\"/to-tickets\",\"className\":\"ah-code-inline\"}],\" has run.\"],\"className\":\"ah-prose-p\"}]\n60:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Why not go straight from grilling to \",[\"$\",\"code\",null,{\"children\":\"/to-tickets\",\"className\":\"ah-code-inline\"}],\" and skip the spec?\"],\"className\":\"ah-prose-strong\"}],\"\\nOften you should. The spec is worth its step only on multi-session work. Its value is that the tickets are disposable and the spec is not. Each ticket is sized for one fresh context window and then gets deleted or closed, while the spec stays as the one place that records the reasoning behind them. On a single-session change, that gives you nothing, and you pay for an extra synthesis step where the \",[\"$\",\"$L53\",null,{\"href\":\"/ai-coding-dictionary/model\",\"dictionaryTitle\":\"Model\",\"dictionaryDescription\":\"The parameters. Stateless — does next-token prediction and nothing else. Cannot do anything agentic on its own.\",\"children\":\"model\"}],\" can drift. Go from grilling to \",[\"$\",\"code\",null,{\"children\":\"/implement\",\"className\":\"ah-code-inline\"}],\".\"],\"className\":\"ah-prose-p\"}]\n61:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"I just finished a wayfinder map. What do I feed it?\",\"className\":\"ah-prose-strong\"}],\"\\nGive it the main map issue, \",[\"$\",\"code\",null,{\"children\":\"/to-spec #\u003cmap_issue\u003e\",\"className\":\"ah-code-inline\"}],\", not the individual decision tickets. \",[\"$\",\"$L6\",null,{\"href\":\"/skills-wayfinder\",\"title\":\"$undefined\",\"className\":\"ah-prose-a\",\"children\":\"wayfinder\"}],\" produces decisions spread across a map, not deliverables. \",[\"$\",\"code\",null,{\"children\":\"to-spec\",\"className\":\"ah-code-inline\"}],\" collapses them into one document you can build from. If you loop the map straight into \",[\"$\",\"code\",null,{\"children\":\"/implement\",\"className\":\"ah-code-inline\"}],\", you lose that step.\"],\"className\":\"ah-prose-p\"}]\n62:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Is the spec for me to review, or is it just for the agent?\",\"className\":\"ah-prose-strong\"}],\"\\nMostly for the agent, and it reads that way: complete, dense, and full of references. Read the seams and the out-of-scope section. In those two places, a wrong decision is cheapest to catch now and most expensive to find later. People do complain about reading the whole thing, and there is no summary mode. But if the spec surprises you, the grilling was too shallow; the spec is not too long.\"],\"className\":\"ah-prose-p\"}]\n63:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Do I keep the spec frozen once tickets start, or let the agent rewrite it?\",\"className\":\"ah-prose-strong\"}],\"\\nNothing keeps it in sync. In practice it is a snapshot of what you knew at that moment, and it goes out of date the first time implementation teaches you something. Treat it as disposable after the work ships. Your \",[\"$\",\"code\",null,{\"children\":\"GLOSSARY.md\",\"className\":\"ah-code-inline\"}],\" and ADRs are the files meant to last. If you learn something during implementation that should last, put it there, not in an edited spec.\"],\"className\":\"ah-prose-p\"}]\n64:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"My work is a refactor or a module boundary, not a feature. Does the template fit?\",\"className\":\"ah-prose-strong\"}],\"\\nLess well, and this is a known limitation. The template relies heavily on user stories, which do not fit architectural work. You end up writing stories nobody asked for around decisions that are really about interfaces and invariants. Use the implementation-decisions and testing-decisions sections instead. Record the lasting architectural decisions as ADRs through \",[\"$\",\"$L6\",null,{\"href\":\"/skills-grill-with-docs\",\"title\":\"$undefined\",\"className\":\"ah-prose-a\",\"children\":\"grill-with-docs\"}],\", not in the spec.\"],\"className\":\"ah-prose-p\"}]\n65:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Will it check the tracker for related work, or cite the ADRs it's respecting?\",\"className\":\"ah-prose-strong\"}],\"\\nNo to both. It reads and follows the ADRs for the area it touches, but it does not link them. It also does not search the tracker for overlapping issues before it writes, so a spec can duplicate work that someone already filed, and nothing warns you. If the area is busy, search the tracker yourself first.\"],\"className\":\"ah-prose-p\"}]\n66:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"/to-tickets\",\"className\":\"ah-code-inline\"}],\" couldn't read my spec: it kept truncating.\"],\"className\":\"ah-prose-strong\"}],\"\\nA tracker issue may not return a very large spec in full, and there is no local copy to use instead. To fix this, do not \",[\"$\",\"$L53\",null,{\"href\":\"/ai-coding-dictionary/clearing\",\"dictionaryTitle\":\"Clearing\",\"dictionaryDescription\":\"Ending the current session and starting a fresh one. The next message begins with an empty session and an empty context window.\",\"children\":\"clear\"}],\" or \",[\"$\",\"$L53\",null,{\"href\":\"/ai-coding-dictionary/compaction\",\"dictionaryTitle\":\"Compaction\",\"dictionaryDescr