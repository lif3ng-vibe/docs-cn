]\n50:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Data loss\",\"className\":\"ah-prose-strong\"}],\" or destruction\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Non-compliance\",\"className\":\"ah-prose-strong\"}],\" with industry or corporate standards\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Breaking changes\",\"className\":\"ah-prose-strong\"}],\" subtle enough to escape notice until it's too late\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Most existential of all: getting stuck in the mud as you \",[\"$\",\"strong\",null,{\"children\":\"lose your \\\"sense\\\" for a codebase\",\"className\":\"ah-prose-strong\"}]]}],\"\\n\"],\"className\":\"ah-bullets\"}]\n51:[\"$\",\"p\",null,{\"children\":\"That last one should really be on ALL of our minds, because losing this sense isn't just an emotional reaction. It's a genuine cognitive loss that leads to a loss of understanding, team confusion, and the kind of overwhelm that does real (and possibly long term) damage to devs and their teams.\",\"className\":\"ah-prose-p\"}]\n52:[\"$\",\"p\",null,{\"children\":[\"These are high stakes, and the costs can be \",[\"$\",\"em\",null,{\"children\":\"staggering\",\"className\":\"ah-prose-em\"}],\".\"],\"className\":\"ah-prose-p\"}]\n53:[\"$\",\"p\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"But these problems aren't new problems, even though they're accelerated by new tools.\",\"className\":\"ah-prose-strong\"}],\"className\":\"ah-prose-p\"}]\n54:[\"$\",\"p\",null,{\"children\":\"Software developers like you have faced these same challenges with every innovation: from scripting languages to GUIs to advanced web frameworks, from outsourcing to distributed computing.\",\"className\":\"ah-prose-p\"}]\n55:[\"$\",\"p\",null,{\"children\":\"This is the legacy of engineering: our tools are always changing. And we're always adapting.\",\"className\":\"ah-prose-p\"}]\n56:[\"$\",\"p\",null,{\"children\":\"We can use these new tools to accelerate new solutions, too.\",\"className\":\"ah-prose-p\"}]\n57:[\"$\",\"p\",null,{\"children\":[\"That's why \",[\"$\",\"strong\",null,{\"children\":\"real engineering skills\",\"className\":\"ah-prose-strong\"}],\" matter, today, tomorrow, and forever.\"],\"className\":\"ah-prose-p\"}]\n58:[\"$\",\"hr\",null,{\"className\":\"ah-prose-hr\"}]\n59:[\"$\",\"$L42\",null,{\"level\":2,\"children\":[\"Second step: \",[\"$\",\"em\",null,{\"children\":\"Think\",\"className\":\"ah-prose-em\"}],\" like an engineer\"]}]\n5a:[\"$\",\"p\",null,{\"children\":\"A real engineer knows their tools intimately: what a tool is good for, how and where it excels, where it fails or falters, and how it breaks.\",\"className\":\"ah-prose-p\"}]\n5b:[\"$\",\"p\",null,{\"children\":\"And, as an engineer, you should know that while AI is a new and unusual tool… it's still a tool. One you must fit intentionally into your professional software development process.\",\"className\":\"ah-prose-p\"}]\n5c:[\"$\",\"p\",null,{\"children\":[\"You can build the process that \",[\"$\",\"em\",null,{\"children\":\"makes\",\"className\":\"ah-prose-em\"}],\" these tools trustworthy.\"],\"className\":\"ah-prose-p\"}]\n5d:[\"$\",\"p\",null,{\"children\":\"These are the core engineering skills you'll need to get the most out of Claude Code, or any AI-coding assistant:\",\"className\":\"ah-prose-p\"}]\n5e:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Communicating\",\"className\":\"ah-prose-strong\"}],\": clearly sharing your thoughts, ideas, observations, requirements\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Anticipating\",\"className\":\"ah-prose-strong\"}],\": quickly identifying potential problems before they happen\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Planning:\",\"className\":\"ah-prose-strong\"}],\" reliably turning huge chunks of work into well-formatted PRDs\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Decomposing:\",\"className\":\"ah-prose-strong\"}],\" thoughtfully breaking down big plans into well-scoped, iterative tasks\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Delegating\",\"className\":\"ah-prose-strong\"}],\": confidently knowing what \u0026 how to offload tasks\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Systematizing\",\"className\":\"ah-prose-strong\"}],\": consistently building feedback loops that produce quality outputs (types, tests, \u0026 reviews)\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Parallelizing\",\"className\":\"ah-prose-strong\"}],\": mindfully balancing quality assurance and coding, for maximum productivity\"]}],\"\\n\"],\"className\":\"ah-bullets\"}]\n5f:[\"$\",\"p\",null,{\"children\":[\"These aren't new ideas. This \",[\"$\",\"em\",null,{\"children\":\"is\",\"className\":\"ah-prose-em\"}],\" engineering.\"],\"className\":\"ah-prose-p\"}]\n60:[\"$\",\"p\",null,{\"children\":\"And I'll let you in on a little secret: these higher-order skills apply just as much to working effectively with people, not just coding agents.\",\"className\":\"ah-prose-p\"}]\n61:[\"$\",\"p\",null,{\"children\":[\"Real engineering is the only way to generate safe, worthwhile, \",[\"$\",\"em\",null,{\"children\":\"long-lasting\",\"className\":\"ah-prose-em\"}],\" code… by hand, or with AI tools.\"],\"className\":\"ah-prose-p\"}]\n62:[\"$\",\"p\",null,{\"children\":[\"If you don't use these skills - or you don't \",[\"$\",\"em\",null,{\"children\":\"consistently\",\"className\":\"ah-prose-em\"}],\" use these skills - in your dev process today, today is the day to learn how.\"],\"className\":\"ah-prose-p\"}]\n63:[\"$\",\"p\",null,{\"children\":\"And if you do use these skills today, writing code by hand, now's the time to learn how you can apply them with Claude Code.\",\"className\":\"ah-prose-p\"}]\n64:[\"$\",\"p\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":[\"The way you produce \",[\"$\",\"em\",null,{\"children\":\"lines of code\",\"className\":\"ah-prose-em\"}],\" may change, but the core fundamentals of producing well-engineered \",[\"$\",\"em\",null,{\"children\":\"software\",\"className\":\"ah-prose-em\"}],\" is eternal.\"],\"className\":\"ah-prose-strong\"}],\"className\":\"ah-prose-p\"}]\n65:[\"$\",\"p\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":\"Your\",\"className\":\"ah-prose-em\"}],\" engineering skills make the difference between success and failure, enhanced productivity and technical debt at speed, safe code and code that risks everything.\"],\"className\":\"ah-prose-p\"}]\n66:[\"$\",\"hr\",null,{\"className\":\"ah-prose-hr\"}]\n67:[\"$\",\"$L42\",null,{\"level\":2,\"children\":\"Now: Learn to use AI coding like a real engineer\"}]\n68:[\"$\",\"p\",null,{\"children\":[\"When \",[\"$\",\"em\",null,{\"children\":\"you\",\"className\":\"ah-prose-em\"}],\" practice real engineering, \",[\"$\",\"em\",null,{\"children\":\"you\",\"className\":\"ah-prose-em\"}],\" unlock the power of Claude Code.\"],\"className\":\"ah-prose-p\"}]\n69:[\"$\",\"p\",null,{\"children\":[\"For example, I've always dreamed about building the perfect course creator, designed specifically for \",[\"$\",\"em\",null,{\"children\":\"my\",\"className\":\"ah-prose-em\"}],\" personal course development process.\"],\"className\":\"ah-prose-p\"}]\n6a:[\"$\",\"p\",null,{\"children\":[\"From keeping my ideas organized, to the actual recording and editing process. I just knew that the right piece of software could let me focus more on making the learning experience \",[\"$\",\"em\",null,{\"children\":\"amazing.\",\"className\":\"ah-prose-em\"}]],\"className\":\"ah-prose-p\"}]\n6b:[\"$\",\"p\",null,{\"children\":\"But this is my livelihood. It couldn't just be a vibe coded weekend project. I needed a reliable, professional grade tool, and knew that justifying that kind of time investment never made sense.\",\"className\":\"ah-prose-p\"}]\n6c:[\"$\",\"p\",null,{\"children\":\"So for multiple years, that tool remained a pipe dream, with many aborted attempts.\",\"className\":\"ah-prose-p\"}]\n6d:[\"$\",\"p\",null,{\"children\":\"But since I've started using Claude Code with Ralph loops, I've shipped over 1,000 commits, and created and closed over 500 of my own issues. Today, my professional-grade course creator includes things I never imagined possible:\",\"className\":\"ah-prose-p\"}]\n6e:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"a full in-browser video editor\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"AI writing assistant with 14 unique modes\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Dropbox/CMS/YouTube/X/LinkedIn sync\"}],\"\\n\"],\"className\":\"ah-bullets\"}]\n6f:[\"$\",\"p\",null,{\"children\":\"It’s all powered by TypeScript (obviously), and backed by the amazing Effect.ts library.\",\"className\":\"ah-prose-p\"}]\n70:[\"$\",\"p\",null,{\"children\":[\"And here's the kicker: I built everything in \",[\"$\",\"em\",null,{\"children\":\"my spare time\",\"className\":\"ah-prose-em\"}],\", while running my business \",[\"$\",\"em\",null,{\"children\":\"and enjoying\",\"className\":\"ah-prose-em\"}],\" life as the loving dad of my 2-year old.\"],\"className\":\"ah-prose-p\"}]\n71:[\"$\",\"p\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"I want to share that power with you.\",\"className\":\"ah-prose-strong\"}],\"className\":\"ah-prose-p\"}]\n72:[\"$\",\"p\",null,{\"children\":\"So I went into brainstorm mode, and asked myself:\",\"className\":\"ah-prose-p\"}]\n73:[\"$\",\"p\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":[\"What do developers need to become \",[\"$\",\"em\",null,{\"children\":\"engineers\",\"className\":\"ah-prose-em\"}],\" empowered by Claude Code?\"],\"className\":\"ah-prose-strong\"}],\"className\":\"ah-prose-p\"}]\n74:[\"$\",\"p\",null,{\"children\":\"And that's how AI Coding for Real Engineers came to be.\",\"className\":\"ah-prose-p\"}]\n75:[\"$\",\"p\",null,{\"children\":\"I designed a new 2-week course for you, where you will…\",\"className\":\"ah-prose-p\"}]\n76:[\"$\",\"$L47\",null,{\"children\":[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"learn \u0026 refresh timeless engineering skills\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"update your engineering skills to include a new AI-assisted development workflow\"}],\"\\n\"],\"className\":\"ah-bullets\"}]}]\n77:[\"$\",\"p\",null,{\"children\":[\"You'll learn the fundamentals of how Claude Code works, what it can \u0026 can't do, how to prep your work, manage and steer it with token-efficient but reliable rules, keep your projects on track and on spec, test outputs, and \",[\"$\",\"strong\",null,{\"children\":\"ensure quality at every step\",\"className\":\"ah-prose-strong\"}],\".\"],\"className\":\"ah-prose-p\"}]\n78:[\"$\",\"p\",null,{\"children\":\"You'll learn how you can fit Claude Code into a real-world production environment, with an existing codebase and procedures.\",\"className\":\"ah-prose-p\"}]\n79:[\"$\",\"p\",null,{\"children\":[\"And you'll experience how correctly wielding a powerful tool like Claude Code can \",[\"$\",\"em\",null,{\"children\":\"strengthen\",\"className\":\"ah-prose-em\"}],\" your abilities and \",[\"$\",\"em\",null,{\"children\":\"deepen\",\"className\":\"ah-prose-em\"}],\" your understanding of your codebase.\"],\"className\":\"ah-prose-p\"}]\n7a:[\"$\",\"p\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"In other words: You'll go from vibe coder to AI Hero.\",\"className\":\"ah-prose-strong\"}],\"className\":\"ah-prose-p\"}]\n7b:[[\"$\",\"$L40\",null,{\"moduleIds\":[\"1194103553481754355\"]}],\"$Ld6\"]\n7c:[\"$\",\"p\",null,{\"children\":[\"$\",\"em\",null,{\"children\":\"(All these fundamentals apply to other AI coding tools, of course - but I've picked Claude Code because, for me, it's the current best-in-class.)\",\"className\":\"ah-prose-em\"}],\"className\":\"ah-prose-p\"}]\n7d:[\"$\",\"div\",null,{\"className\":\"not-prose mx-auto my-8 flex max-w-xl flex-col items-center gap-2.5 text-center\",\"children\":[[\"$\",\"$Ld5\",null,{\"actionLabel\":\"Join Waitlist\",\"productName\":\"AI Coding for Real Engineers (Cohort 4)\",\"surface\":\"cohort-page\",\"knownIdentity\":false}],null]}]\n7e:[\"$\",\"hr\",null,{\"className\":\"ah-prose-hr\"}]\n7f:[\"$\",\"$L42\",null,{\"level\":2,\"children\":[\"Join \",[\"$\",\"em\",null,{\"children\":\"AI Coding for Real Engineers\",\"className\":\"ah-prose-em\"}],\" starting Monday June 1\"]}]\n80:[\"$\",\"$L37\",null,{\"src\":\"https://res.cloudinary.com/total-typescript/image/upload/v1778482299/cohorts/cohort-m0k0w/fh5sosv36pw0ogibmc0p.jpg\",\"width\":737,\"height\":393,\"alt\":\"AI Coding for Real Engineers\",\"className\":\"mx-auto\"}]\n81:[\"$\",\"p\",null,{\"children\":[\"My newest 2-week async cohort course offers you my best AI coding material to date, based on real-world production experience. And it's all designed for you to apply to \",[\"$\",\"em\",null,{\"children\":\"your\",\"className\":\"ah-prose-em\"}],\" real-world projects.\"],\"className\":\"ah-prose-p\"}]\n82:[[\"$\",\"$L40\",null,{\"moduleIds\":[\"9420084275150112986\"]}],\"$Ld7\"]\n83:[\"$\",\"$L37\",null,{\"src\":\"https://res.cloudinary.com/total-typescript/image/upload/v1762947890/cohorts/cohort-ytorn/bcauxini0z3jbcsdnvv9.png\",\"width\":737,\"height\":132,\"alt\":\"\",\"loading\":\"lazy\"}]\n84:[\"$\",\"$L42\",null,{\"level\":3,\"children\":\"Full Schedule: What you'll be learning, doing, and building each week\"}]\n85:[\"$\",\"p\",null,{\"children\":\"Each Monday, you'll get full access to that week's lessons, letting you pick your pace and schedule. Rip through lessons, or take your time; revisit to make sure you understand, and bring questions to Office Hours!\",\"className\":\"ah-prose-p\"}]\n86:[\"$\",\"p\",null,{\"children\":\"Here's what's you can look forward to, in detail:\",\"className\":\"ah-prose-p\"}]\n87:[\"$\",\"$L42\",null,{\"level\":3,\"children\":\"Pre-course: Getting to Know Claude Code\"}]\n88:[\"$\",\"p\",null,{\"children\":\"To help you hit the ground running on Day 1, once you enroll you'll get immediate access to a collection of \\\"Getting to Know Claude Code\\\" lessons that I designed specifically for this course.\",\"className\":\"ah-prose-p\"}]\n89:[\"$\",\"p\",null,{\"children\":\"If you're brand new to Claude Code, this will help you get you comfortable with key terminology and features in the CLI coding assistant. And if you're already comfortable, this will be a useful and breezy refresher!\",\"className\":\"ah-prose-p\"}]\n8a:[\"$\",\"$L37\",null,{\"src\":\"https://res.cloudinary.com/total-typescript/image/upload/v1762947890/cohorts/cohort-ytorn/e8qoqfwxsp9zsqrzvfnl.png\",\"width\":737,\"height\":132,\"alt\":\"\",\"loading\":\"lazy\"}]\n8b:[\"$\",\"$L42\",null,{\"level\":3,\"children\":\"Week 1: Fundamentals, Steering \u0026 Planning\"}]\n8c:[\"$\",\"p\",null,{\"children\":[\"$\",\"em\",null,{\"children\":\"This week, we will build your engineering toolkit for working with an AI coding agent.\",\"className\":\"ah-prose-em\"}],\"className\":\"ah-prose-p\"}]\n8d:[\"$\",\"p\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"We'll start by making sure you understand the real constraints of LLMs, and how to manage them, all while using Claude Code to successfully build a new feature in a production-grade codebase.\",\"className\":\"ah-prose-strong\"}],\"className\":\"ah-prose-p\"}]\n8e:[\"$\",\"p\",null,{\"children\":\"You'll learn how context windows work, why managing them carefully matters, and how subagents can help you keep your context window clean. We'll practice exploring large codebases and using the Plan/Execute/Clear loop.\",\"className\":\"ah-prose-p\"}]\n8f:[\"$\",\"p\",null,{\"children\":\"Combined, all of these techniques help your coding assistant stay in the \\\"smart zone\\\" where it writes great code, and avoid the \\\"dumb zone\\\" that sends it in circles.\",\"className\":\"ah-prose-p\"}]\n90:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Then you'll learn to steer the coding assistant.\",\"className\":\"ah-prose-strong\"}],\" You'll write an AGENTS.md file that doesn't waste tokens on unnecessary instructions, and instead teach your agent how to conform to your team's preferences and expertise using custom skills and progressive disclosure (all while preventing wasted tokens).\"],\"className\":\"ah-prose-p\"}]\n91:[\"$\",\"p\",null,{\"children\":\"By the end of the first week, you'll be planning and building features like a senior engineer:\",\"className\":\"ah-prose-p\"}]\n92:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"decomposing full-size features into context-window-sized chunks to build\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"writing PRDs with a purpose-built skill\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"using tracer bullets to validate architecture before committing to a full build\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"and executing multi-phase plans that ship features far bigger than any single agent session can handle\"}],\"\\n\"],\"className\":\"ah-bullets\"}]\n93:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"We'll wrap up Week 1 with Office Hours\",\"className\":\"ah-prose-strong\"}],\". Bring your questions, get direct answers. Can't make it live? Submit your question in advance and get the recording and transcript.\"],\"className\":\"ah-prose-p\"}]\n94:[\"$\",\"$L37\",null,{\"src\":\"https://res.cloudinary.com/total-typescript/image/upload/v1762947890/cohorts/cohort-ytorn/qzrjvahpmekjz5cctzrh.png\",\"width\":737,\"height\":132,\"alt\":\"\",\"loading\":\"lazy\"}]\n95:[\"$\",\"$L42\",null,{\"level\":3,\"children\":\"Week 2: Feedback Loops, AFK Agents \u0026 Human-in-the-Loop Patterns\"}]\n96:[\"$\",\"p\",null,{\"children\":[\"Week 2 stacks on top of everything you learn in week 1, introducing systems that make AI-assisted software engineering both \",[\"$\",\"em\",null,{\"children\":\"trustworthy\",\"className\":\"ah-prose-em\"}],\" and \",[\"$\",\"em\",null,{\"children\":\"reliable\",\"className\":\"ah-prose-em\"}],\".\"],\"className\":\"ah-prose-p\"}]\n97:[\"$\",\"p\",null,{\"children\":\"First, you'll find out why a green CI pipeline is non-negotiable when working with agents, and learning what kinds of tests do (and don't) belong in your agent's red-green-refactor workflow. You'll build a custom \\\"skill\\\" that encodes your team's quality bar into every task, and pre-commit hooks that add a deterministic safety net to your code quality!\",\"className\":\"ah-prose-p\"}]\n98:[\"$\",\"p\",null,{\"children\":\"Then, the key to automating your engineering workflow: the \\\"Ralph Wiggum\\\" loop, a deceptively simple and incredibly powerful pattern for letting your agent autonomously build entire features into your app.\",\"className\":\"ah-prose-p\"}]\n99:[\"$\",\"p\",null,{\"children\":\"You'll learn and practice running Ralph in two modes: first, with \\\"human-in-the-loop\\\" mode (hint: you're that human). HITL gives you both visibility and control while you're learning.\",\"className\":\"ah-prose-p\"}]\n9a:[\"$\",\"p\",null,{\"children\":\"Then we'll take off the training wheels and set up a safe sandbox for Claude Code to operate entirely on its own (while you are AFK), pulling from a GitHub Issues backlog, prioritizing fixes and features, and committing changes to branches. With just a bit of practice, you'll have it churning through work while you focus on other things that matter most.\",\"className\":\"ah-prose-p\"}]\n9b:[\"$\",\"p\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"By the end of week two, you'll have a clear sense of when to stay in the loop vs. go AFK autonomous, including:\",\"className\":\"ah-prose-strong\"}],\"className\":\"ah-prose-p\"}]\n9c:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"how and when to run research phases that save future sessions hours of work\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"the power of flexible kanban boards instead of upfront plans\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"and maybe most importantly, how to make sure that your codebase is prepared for AI agents to actually navigate it effectively.\"}],\"\\n\"],\"className\":\"ah-bullets\"}]\n9d:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Week 2 Office Hours with Matt\",\"className\":\"ah-prose-strong\"}],\". Same format, deeper questions. By now you'll have real experience to draw from, so we can help you connect the dots between your practice and real work in your codebase!\"],\"className\":\"ah-prose-p\"}]\n9e:[\"$\",\"$L37\",null,{\"src\":\"https://res.cloudinary.com/total-typescript/image/upload/v1762947890/cohorts/cohort-ytorn/xagmuofo0mu7qtj6weeq.png\",\"width\":737,\"height\":132,\"alt\":\"\",\"loading\":\"lazy\"}]\n9f:[\"$\",\"$L42\",null,{\"level\":3,\"children\":\"Your future with AI coding is inside\"}]\na0:[\"$\",\"p\",null,{\"children\":\"This course focuses on the Claude Code CLI, which is where I've honed these skills and gotten the best results myself. So it's the best way for me to teach you!\",\"className\":\"ah-prose-p\"}]\na1:[\"$\",\"p\",null,{\"children\":[\"But once you've practiced the skills here, you'll be able to use the same techniques and knowledge in just about \",[\"$\",\"em\",null,{\"children\":\"any\",\"className\":\"ah-prose-em\"}],\" CLI coding assistant, with virtually any frontier AI model.\"],\"className\":\"ah-prose-p\"}]\na2:[\"$\",\"p\",null,{\"children\":\"And the more you practice these skills, the better judgement you'll bring to using coding assistants in production-grade codebases.\",\"className\":\"ah-prose-p\"}]\na3:[\"$\",\"$L42\",null,{\"level\":3,\"children\":\"Learn on your schedule, from anywhere\"}]\na4:[\"$\",\"p\",null,{\"children\":\"AI Coding for Real Engineers is the most flexible course I've ever offered:\",\"className\":\"ah-prose-p\"}]\na5:[\"$\",\"p\",null,{\"children\":\"Instead of being yoked to a semi-daily schedule, you'll receive the entire weeks' worth of lessons each Monday, so you can work ahead or take it slow.\",\"className\":\"ah-prose-p\"}]\na6:[\"$\",\"p\",null,{\"children\":\"You'll gain access to 6 live Office Hours across 3 days - staggered for different time zones - to give you the most opportunity to get personal help directly from me. Ask ahead if you can't make it; recordings and transcripts are always included.\",\"className\":\"ah-prose-p\"}]\na7:[\"$\",\"p\",null,{\"children\":\"And, of course, you'll get invited to my private AI Hero Discord, with an exclusive channel for you to meet \u0026 learn along with your fellow attendees.\",\"className\":\"ah-prose-p\"}]\na8:[\"$\",\"p\",null,{\"children\":\"This way, you get the best of sync and async courses in one great experience.\",\"className\":\"ah-prose-p\"}]\na9:[\"$\",\"div\",null,{\"id\":\"office-hours\"}]\nab:[\"$\",\"$L37\",null,{\"src\":\"https://res.cloudinary.com/total-typescript/image/upload/v1762947890/cohorts/cohort-ytorn/r4cespl7dgsdkuw0v3cf.png\",\"width\":737,\"height\":132,\"alt\":\"\",\"loading\":\"lazy\"}]\nac:[\"$\",\"$L42\",null,{\"level\":2,\"children\":\"What's included\"}]\nad:[\"$\",\"p\",null,{\"children\":[\"For \",[\"$\",\"$L3e\",null,{\"type\":\"original\",\"pricingDataLoader\":\"$@3f\"}],\" you'll learn everything you need to use AI coding like a real engineer.\"],\"className\":\"ah-prose-p\"}]\nae:[\"$\",\"p\",null,{\"children\":\"Here's what you get when you enroll:\",\"className\":\"ah-prose-p\"}]\naf:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"All lessons and coding exercises\",\"className\":\"ah-prose-strong\"}],\". Tight, snappy videos and hands-on practice in a safe sandbox environment. Yours to keep forever.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"The course code repo\",\"className\":\"ah-prose-strong\"}],\". Clone it, reference it, build on it. It's yours.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Pre-course access\",\"className\":\"ah-prose-strong\"}],\". Getting to Know Claude Code lessons available before the cohort so you are ready on Day 1.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Live Office Hours with Matt\",\"className\":\"ah-prose-strong\"}],\". Live Q\u0026A sessions on Monday June 1, Monday June 8, and Friday June 12, with two time-zone friendly options each office hours day. Submit questions in advance if you can't join live.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"All recordings and transcripts\",\"className\":\"ah-prose-strong\"}],\". Every office hours session, captured and available for replay.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Exclusive Discord access\",\"className\":\"ah-prose-strong\"}],\". Learn alongside your fellow students, ask questions, share wins, and soak up the energy of a group of smart folks figuring things out together.\"]}],\"\\n\"],\"className\":\"ah-bullets\"}]\nb0:[\"$\",\"p\",null,{\"children\":\"Everything listed here is yours to keep so you can revisit them any time as a reference, as a refresher, or to go deeper with exercises you didn't get to during the cohort.\",\"className\":\"ah-prose-p\"}]\nb1:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Enroll today\",\"className\":\"ah-prose-strong\"}],\" to 