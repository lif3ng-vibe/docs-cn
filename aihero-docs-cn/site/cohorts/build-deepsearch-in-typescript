oreground/60 mt-0.5 shrink-0 font-mono text-[11px] font-medium uppercase tabular-nums tracking-wider\",\"aria-hidden\":\"true\",\"children\":\"09\"}],[\"$\",\"div\",null,{\"className\":\"flex min-w-0 flex-1 flex-col gap-1\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"truncate text-[14px] font-medium leading-tight tracking-[-0.005em]\",\"children\":\"Day 8: Agents vs Workflows\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground/70 truncate font-mono text-[11px] font-medium uppercase tracking-wider\",\"children\":\"Available from July 22, 2025\"}]]}]]}]}],[\"$\",\"$L4c\",null,{\"className\":\"pb-0 border-t\",\"children\":[\"$\",\"ol\",null,{\"className\":\"divide-border list-inside list-none divide-y\",\"children\":[\"$\",\"$L4d\",null,{\"workshopNavDataLoader\":\"$@74\",\"children\":[\"$\",\"$L4f\",null,{\"workshop\":{\"id\":\"workshop-n3tek\",\"organizationId\":null,\"createdByOrganizationMembershipId\":null,\"type\":\"workshop\",\"createdById\":\"0548650a-98a3-4d9c-ae9a-20655eb0622f\",\"fields\":{\"body\":\"In this workshop we're going to adjust the amount of power we give to the LLM to choose our control flow.\\n\\nDoing this bumps up against a hot topic in AI engineering circles - **agents vs workflows.**\\n\\nThe opposite of an 'agent' is a 'workflow'. \\n\\nThe less 'agentic' your application is, the more predictable it becomes. Entirely deterministic applications do the same thing every time - even if they contain some probabilistic components.\\n\\nAgentic systems aren't all bad - letting the LLM handle the control flow means your application becomes very flexible.\\n\\nBut in a system like DeepSearch, we may want to experiment with adding more determinism to our system.\\n\\n**In our next few exercises, we're going to experiment with turning the dial back towards determinism.**\",\"slug\":\"day-8-agents-vs-workflows\",\"yDoc\":\"AAA=\",\"state\":\"published\",\"title\":\"Day 8: Agents vs Workflows\",\"github\":\"\",\"startsAt\":\"2025-07-23