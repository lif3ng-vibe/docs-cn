---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

// Hero action links are not rebased by Starlight, so resolve the home path
// against the configured base here.
const homeHref = `${import.meta.env.BASE_URL}`;
---

<StarlightPage
  frontmatter={{
    title: '页面不存在',
    description: '请求的页面不存在。',
    editUrl: false,
    pagefind: false,
    template: 'splash',
    head: [
      { tag: 'meta', attrs: { name: 'robots', content: 'noindex' } },
    ],
    hero: {
      title: '页面不存在',
      tagline: '你要找的页面不在这里。',
      actions: [
        { text: '返回首页', link: homeHref, icon: 'left-arrow', variant: 'primary' },
      ],
    },
  }}
/>
