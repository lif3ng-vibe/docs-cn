            <path d="M 208 460 L 224 468 L 224 472 L 208 480 L 192 472 L 192 468 Z" fill="none" stroke="#ededed" stroke-width="0.8" stroke-linejoin="round"/>
            <g data-role="label">
              <line data-role="leader" x1="321.31" y1="450" x2="373" y2="450" stroke="rgba(237,237,237,0.40)" stroke-width="0.8"/>
              <circle cx="315.31" cy="450" r="2" fill="#ededed"/>
              <text data-role="name" x="385" y="449" fill="#ededed" font-size="16" font-weight="600" font-family="'Geist', sans-serif">Your prompt</text>
              <text class="sub" x="385" y="465" fill="#a3a3a3" font-size="10" font-family="'Geist Mono', monospace" letter-spacing="0.08em">“draw our deploy flow”</text>
            </g>
          </g>

          <!-- 2 · SKILL.md -->
          <g data-part="skill" data-name="SKILL.md" data-rect="0 0 120 120 8" data-z="92" data-t="10" data-level="1">
            <path data-role="silhouette" d="M 84.69 354 A 11.31 5.66 0 0 1 88 350 L 192 298 A 11.31 5.66 0 0 1 208 298 L 312 350 A 11.31 5.66 0 0 1 315.31 354 L 315.31 364 A 11.31 5.66 0 0 1 312 368 L 208 420 A 11.31 5.66 0 0 1 192 420 L 88 368 A 11.31 5.66 0 0 1 84.69 364 Z" fill="#1c1c1c"/>
