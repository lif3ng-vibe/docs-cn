            <path d="M 186 365 L 196 370 L 196 375 L 186 380 L 176 375 L 176 370 Z" fill="none" stroke="#ededed" stroke-width="0.8" stroke-linejoin="round"/>
            <g data-role="label">
              <line data-role="leader" x1="321.31" y1="359" x2="373" y2="359" stroke="rgba(237,237,237,0.40)" stroke-width="0.8"/>
              <circle cx="315.31" cy="359" r="2" fill="#ededed"/>
              <text data-role="name" x="385" y="358" fill="#ededed" font-size="16" font-weight="600" font-family="'Geist', sans-serif">SKILL.md</text>
              <text class="sub" x="385" y="374" fill="#a3a3a3" font-size="10" font-family="'Geist Mono', monospace" letter-spacing="0.08em">picks 1 of 50 types</text>
            </g>
          </g>

          <!-- 3 · Type reference (focal) -->
          <g data-part="typeref" data-name="Type reference" data-rect="0 0 120 120 8" data-z="182" data-t="14" data-level="2" data-focal>
            <path data-role="silhouette" d="M 84.69 260 A 11.31 5.66 0 0 1 88 256 L 192 204 A 11.31 5.66 0 0 1 208 204 L 312 256 A 11.31 5.66 0 0 1 315.31 260 L 315.31 274 A 11.31 5.66 0 0 1 312 278 L 208 330 A 11.31 5.66 0 0 1 192 330 L 88 278 A 11.31 5.66 0 0 1 84.69 274 Z" fill="#1c1c1c"/>
