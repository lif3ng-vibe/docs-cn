            <path d="M 84.69 260 A 11.31 5.66 0 0 1 88 256 L 192 204 A 11.31 5.66 0 0 1 208 204 L 312 256 A 11.31 5.66 0 0 1 315.31 260 L 315.31 274 A 11.31 5.66 0 0 1 312 278 L 208 330 A 11.31 5.66 0 0 1 192 330 L 88 278 A 11.31 5.66 0 0 1 84.69 274 Z" fill="none" stroke="#f08a59" stroke-width="1.2" stroke-linejoin="round"/>
            <g transform="matrix(1,0.5,-1,0.5,200,200)">
              <rect x="12" y="12" width="96" height="96" rx="4" fill="none" stroke="rgba(240,138,89,0.70)" stroke-width="0.8" vector-effect="non-scaling-stroke"/>
