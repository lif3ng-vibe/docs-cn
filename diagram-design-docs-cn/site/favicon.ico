            <path d="M 84.69 354 A 11.31 5.66 0 0 0 88 358 L 192 410 A 11.31 5.66 0 0 0 208 410 L 312 358 A 11.31 5.66 0 0 0 315.31 354" fill="none" stroke="rgba(237,237,237,0.45)" stroke-width="0.8"/>
            <path d="M 84.69 354 A 11.31 5.66 0 0 1 88 350 L 192 298 A 11.31 5.66 0 0 1 208 298 L 312 350 A 11.31 5.66 0 0 1 315.31 354 L 315.31 364 A 11.31 5.66 0 0 1 312 368 L 208 420 A 11.31 5.66 0 0 1 192 420 L 88 368 A 11.31 5.66 0 0 1 84.69 364 Z" fill="none" stroke="#ededed" stroke-width="1.2" stroke-linejoin="round"/>
            <g transform="matrix(1,0.5,-1,0.5,200,294)">
              <path d="M55 13h10v10h-10Z M69 13h10v10h-10Z M83 13h10v10h-10Z M97 13h10v10h-10Z M41 27h10v10h-10Z M55 27h10v10h-10Z M69 27h10v10h-10Z M83 27h10v10h-10Z M97 27h10v10h-10Z M13 41h10v10h-10Z M27 41h10v10h-10Z M41 41h10v10h-10Z M55 41h10v10h-10Z M69 41h10v10h-10Z M83 41h10v10h-10Z M97 41h10v10h-10Z M13 55h10v10h-10Z M27 55h10v10h-10Z M41 55h10v10h-10Z M55 55h10v10h-10Z M69 55h10v10h-10Z M83 55h10v10h-10Z M97 55h10v10h-10Z M13 69h10v10h-10Z M27 69h10v10h-10Z M41 69h10v10h-10Z M55 69h10v10h-10Z M69 69h10v10h-10Z M83 69h10v10h-10Z M97 69h10v10h-10Z M13 83h10v10h-10Z M27 83h10v10h-10Z M41 83h10v10h-10Z M55 83h10v10h-10Z M83 83h10v10h-10Z M97 83h10v10h-10Z M13 97h10v10h-10Z M27 97h10v10h-10Z M41 97h10v10h-10Z M55 97h10v10h-10Z M69 97h10v10h-10Z M83 97h10v10h-10Z M97 97h10v10h-10Z" fill="rgba(237,237,237,0.14)"/>
            </g>
