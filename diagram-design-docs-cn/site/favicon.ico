    </div>
  </div>
</footer>

<script>
(function(){
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- one authored moment: reveal on enter ---- */
  if(!reduce && 'IntersectionObserver' in window){
    document.body.classList.add('anim');
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {threshold:0.14, rootMargin:'0px 0px -8% 0px'});
    document.querySelectorAll('.hero .rise, .draw').forEach(function(el){ io.observe(el); });
  }

  /* ---- dark / light toggle ---- */
  var modeBtn=document.getElementById('mode');
  function syncMode(){ if(modeBtn) modeBtn.setAttribute('aria-pressed', document.documentElement.getAttribute('data-mode')==='light' ? 'true':'false'); }
  if(modeBtn){ syncMode(); modeBtn.addEventListener('click', function(){ var m=document.documentElement.getAttribute('data-mode')==='light'?'dark':'light'; document.documentElement.setAttribute('data-mode',m); try{localStorage.setItem('dd-mode',m);}catch(e){} syncMode(); }); }

  /* ---- mobile: expand gallery / other hosts ---- */
  document.querySelectorAll('.m-more').forEach(function(b){ b.addEventListener('click', function(){ var t=b.parentNode.querySelector(b.getAttribute('data-more')); if(t){ t.classList.add('open'); } b.setAttribute('aria-expanded','true'); }); });

  /* ---- demo video: one file per mode, no autoplay for reduced motion ---- */
  var demo=document.getElementById('demo');
  function setDemo(){ if(!demo) return; var m=document.documentElement.getAttribute('data-mode')==='light'?'light':'dark';
    var src='assets/demo-'+m+'.mp4'; if(demo.getAttribute('src')===src) return;
    demo.setAttribute('poster','assets/demo-'+m+'-poster.jpg'); demo.setAttribute('src',src);
    if(reduce){ demo.controls=true; } else { var pr=demo.play(); if(pr&&pr.catch) pr.catch(function(){ demo.controls=true; }); } }
  setDemo();
  if(modeBtn) modeBtn.addEventListener('click', setDemo);

  /* ---- modal focus management (shared) ---- */
  var lastFocus = null;
  function focusables(m){
    return Array.prototype.slice.call(m.querySelectorAll('button,[href],video,[tabindex]:not([tabindex="-1"])'))
      .filter(function(el){ return el.tagName==='VIDEO' || el.offsetParent!==null; });
  }
  function trap(m,e){
    if(e.key!=='Tab') return;
    var f=focusables(m); if(!f.length) return;
    var first=f[0], last=f[f.length-1];
    if(e.shiftKey && document.activeElement===first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement===last){ e.preventDefault(); first.focus(); }
  }
  function showModal(m, focusEl){ lastFocus=document.activeElement; m.hidden=false; document.body.style.overflow='hidden'; if(focusEl) focusEl.focus(); }
  function hideModal(m){ m.hidden=true; document.body.style.overflow=''; if(lastFocus && lastFocus.focus){ lastFocus.focus(); } lastFocus=null; }

  /* ---- video: click the poster to open the full demo ---- */
  var vopen=document.querySelector('.film-open'), vmodal=document.getElementById('vmodal'),
      vvideo=document.getElementById('vmodal-video'), vclose=document.getElementById('vclose');
  function openVideo(){ if(!vmodal) return; showModal(vmodal, vclose); try{ vvideo.currentTime=0; var pr=vvideo.play(); if(pr&&pr.catch) pr.catch(function(){}); }catch(e){} }
  function closeVideo(){ if(!vmodal) return; try{ vvideo.pause(); }catch(e){} hideModal(vmodal); }
  if(vopen) vopen.addEventListener('click', openVideo);
  if(vclose) vclose.addEventListener('click', closeVideo);
  if(vmodal){ vmodal.addEventListener('click', function(e){ if(e.target===vmodal) closeVideo(); }); vmodal.addEventListener('keydown', function(e){ trap(vmodal,e); }); }

  /* ---- image lightbox: any [data-full] opens full size (gallery plates + before/after) ---- */
  var imodal=document.getElementById('imodal'), iimg=document.getElementById('imodal-img'),
      icap=document.querySelector('#imodal-cap .t'), iclose=document.getElementById('iclose');
  function openImg(src,label){ if(!imodal||!src) return; iimg.src=src; iimg.alt=(label||'Diagram')+', full size';
    if(icap) icap.textContent=label||''; imodal.setAttribute('aria-label',(label||'Diagram')+', full size'); showModal(imodal, iclose); }
  function closeImg(){ if(!imodal) return; hideModal(imodal); iimg.removeAttribute('src'); }
  document.querySelectorAll('[data-full]').forEach(function(el){
    el.addEventListener('click', function(){ var t=el.querySelector('.t')||el.querySelector('.n'); var light=document.documentElement.getAttribute('data-mode')==='light'&&el.getAttribute('data-full-light'); openImg(light||el.getAttribute('data-full'), t?t.textContent:''); });
    if(el.tagName!=='BUTTON'){ el.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); el.click(); } }); }
  });
  if(iclose) iclose.addEventListener('click', closeImg);
  if(imodal){ imodal.addEventListener('click', function(e){ if(e.target===imodal) closeImg(); }); imodal.addEventListener('keydown', function(e){ trap(imodal,e); }); }

  /* ---- Escape closes whichever modal is open ---- */
  document.addEventListener('keydown', function(e){
    if(e.key!=='Escape') return;
    if(vmodal && !vmodal.hidden) closeVideo();
    else if(imodal && !imodal.hidden) closeImg();
  });

  /* ---- live star count, graceful fallback to the honest "17k+" baseline ---- */
  function fmt(n){ return n>=1000 ? (n/1000).toFixed(n>=10000?0:1).replace('.0','')+'k' : String(n); }
  try{
    fetch('https://api.github.com/repos/cathrynlavery/diagram-design', {headers:{'Accept':'application/vnd.github+json'}})
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(d){ if(d && d.stargazers_count){ var s=fmt(d.stargazers_count);
        var a=document.getElementById('starcount'), b=document.getElementById('starcount2');
        if(a)a.textContent=s; if(b)b.textContent=s+''; } })
      .catch(function(){});
  }catch(e){}

  /* ---- click-to-copy install commands ---- */
  document.querySelectorAll('.sheet').forEach(function(sheet){
    var txt = sheet.getAttribute('data-copy') || '';
    var btn = sheet.querySelector('.cp'), pre = sheet.querySelector('pre');
    function flash(){ if(!btn) return; if(!btn.getAttribute('data-label')) btn.setAttribute('data-label', btn.textContent); btn.textContent='Copied'; btn.classList.add('done'); setTimeout(function(){ btn.textContent=btn.getAttribute('data-label'); btn.classList.remove('done'); },1600); }
    function fb(){ try{ var ta=document.createElement('textarea'); ta.value=txt; ta.style.position='fixed'; ta.style.opacity='0'; document.body.appendChild(ta); ta.focus(); ta.select(); document.execCommand('copy'); document.body.removeChild(ta); flash(); }catch(e){} }
    function doCopy(){ if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(txt).then(flash).catch(fb); } else { fb(); } }
    if(btn) btn.addEventListener('click', doCopy);
    if(pre){ pre.addEventListener('click', doCopy); pre.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); doCopy(); } }); }
  });
})();
</script>
</body>
</html>
