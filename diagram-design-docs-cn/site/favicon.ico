              <rect x="84" y="52" width="16" height="16" rx="2" fill="#1c1c1c" stroke="rgba(237,237,237,0.55)" stroke-width="0.8" vector-effect="non-scaling-stroke"/>
              <rect x="52" y="84" width="16" height="16" rx="2" fill="#1c1c1c" stroke="rgba(237,237,237,0.55)" stroke-width="0.8" vector-effect="non-scaling-stroke"/>
            </g>
            <path d="M 200 248 L 216 256 L 216 260 L 200 268 L 184 260 L 184 256 Z" fill="#f08a59"/>
            <path d="M 184 256 L 200 264 L 200 268 L 184 260 Z" fill="rgba(0,0,0,0.15)"/>
            <path d="M 200 264 L 216 256 L 216 260 L 200 268 Z" fill="rgba(0,0,0,0.35)"/>
            <path d="M 200 248 L 216 256 L 216 260 L 200 268 L 184 260 L 184 256 Z" fill="none" stroke="#f08a59" stroke-width="0.8" stroke-linejoin="round"/>
            <g data-role="label">
              <line data-role="leader" x1="321.31" y1="267" x2="373" y2="267" stroke="rgba(240,138,89,0.60)" stroke-width="0.8"/>
              <circle cx="315.31" cy="267" r="2" fill="#f08a59"/>
              <text data-role="name" x="385" y="266" fill="#ededed" font-size="16" font-weight="600" font-family="'Geist', sans-serif">Type reference</text>
              <text class="sub" x="385" y="282" fill="#f08a59" font-size="10" font-family="'Geist Mono', monospace" letter-spacing="0.08em">layout and density rules</text>
            </g>
