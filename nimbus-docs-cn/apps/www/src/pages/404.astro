---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { LinkButton } from "@/components/ui/link-button";
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import { config } from "virtual:nimbus/config";

const homeHref = withBase("/", import.meta.env.BASE_URL);
const componentsHref = withBase("/components", import.meta.env.BASE_URL);
---

<BaseLayout
  title={`404 — 页面不存在 · ${config.title}`}
  description="你访问的页面不存在或已迁移。"
  noindex
>
  <main
    id="main-content"
    class="mx-auto flex min-h-[calc(100vh-4rem)] w-full max-w-2xl flex-col items-start justify-center gap-6 px-6 py-24"
  >
    <p class="font-mono text-sm text-muted-foreground">404</p>
    <h1 class="text-4xl font-semibold tracking-tight text-foreground">
      页面不存在
    </h1>
    <p class="text-base text-muted-foreground">
      你访问的页面不存在或已迁移。
    </p>
    <div class="mt-2 flex flex-wrap gap-3">
      <LinkButton href={homeHref} variant="primary" icon>返回首页</LinkButton>
      <LinkButton href={componentsHref} variant="secondary">浏览组件</LinkButton>
    </div>
  </main>
</BaseLayout>
